<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- P2-04：与 SystemAdapters 保持同一平台版本，引用 WinRT 投影（Windows.Graphics.Capture）。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\lumina.ico</ApplicationIcon>
    <!-- WPF 主导，DPI 由 app.manifest 声明；WinForms 仅用于托盘图标，忽略其清单检查。 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\lumina.ico" />
    <Resource Include="Assets\lumina-logo.png" />
  </ItemGroup>

  <!-- 到点提示音：随程序输出，设置页可在两段音效之间切换或静音。 -->
  <ItemGroup>
    <Content Include="Sounds\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumina.UI.Wpf\Lumina.UI.Wpf.csproj" />
    <ProjectReference Include="..\Lumina.Services\Lumina.Services.csproj" />
    <ProjectReference Include="..\Lumina.Data\Lumina.Data.csproj" />
    <ProjectReference Include="..\Lumina.SystemAdapters\Lumina.SystemAdapters.csproj" />
    <ProjectReference Include="..\Lumina.Widgets\Lumina.Widgets.csproj" />
    <ProjectReference Include="..\Lumina.Domain\Lumina.Domain.csproj" />
  </ItemGroup>

</Project>
