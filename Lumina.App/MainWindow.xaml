<Window x:Class="Lumina.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拾光 · Lumina"
        Width="1180"
        Height="800"
        MinWidth="1000"
        MinHeight="640"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Lumina.App;component/Assets/lumina.ico"
        Background="{DynamicResource Theme.WallBrush}"
        TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
        TextElement.FontSize="{DynamicResource Theme.FontSize.Body}"
        TextElement.Foreground="{DynamicResource Theme.TextBrush}">
    <Border x:Name="RootBorder"
            BorderBrush="{DynamicResource Theme.BorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource Theme.WallBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 自定义标题栏：拖动区域与窗口按钮 -->
            <Grid Grid.Row="0" Background="{DynamicResource Theme.MicaBrush}">
                <Border Background="Transparent"
                        MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Image Source="pack://application:,,,/Lumina.App;component/Assets/lumina-logo.png"
                               Width="18"
                               Height="18"
                               Stretch="Uniform" />
                        <TextBlock Text="拾光 · Lumina"
                                   Margin="8,0,0,0"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimizeButton"
                            Content="&#xE921;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="11"
                            ToolTip="最小化"
                            Style="{StaticResource Theme.Button.Ghost}"
                            Width="44"
                            Height="44"
                            Padding="0"
                            Click="OnMinimizeClick" />
                    <Button x:Name="MaximizeButton"
                            Content="&#xE922;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="11"
                            ToolTip="最大化"
                            Style="{StaticResource Theme.Button.Ghost}"
                            Width="44"
                            Height="44"
                            Padding="0"
                            Click="OnMaximizeClick" />
                    <Button x:Name="CloseButton"
                            Content="&#xE711;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="11"
                            ToolTip="关闭到托盘（后台继续运行）"
                            Style="{StaticResource Theme.Button.Ghost}"
                            Width="44"
                            Height="44"
                            Padding="0"
                            Click="OnCloseClick" />
                </StackPanel>
            </Grid>

            <ContentControl x:Name="Root" Grid.Row="1" />
        </Grid>
    </Border>
</Window>
