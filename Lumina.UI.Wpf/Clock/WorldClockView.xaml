<UserControl x:Class="Lumina.UI.Wpf.Clock.WorldClockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
             TextElement.FontSize="{DynamicResource Theme.FontSize.Body}"
             TextElement.Foreground="{DynamicResource Theme.TextBrush}"
             Background="Transparent">
    <Border Style="{StaticResource Theme.Card}">
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <TextBlock Text="世界时钟" Style="{StaticResource Theme.Text.SectionTitle}" Margin="0" />
                <Button x:Name="AddCityButton"
                        Content="添加城市"
                        Style="{StaticResource Theme.Button.Secondary}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="添加城市"
                        Click="OnAddCityClick" />
            </Grid>

            <ItemsControl x:Name="CardsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card"
                                Style="{StaticResource Theme.Card}"
                                Margin="0,0,10,10"
                                Padding="13">
                            <StackPanel>
                                <TextBlock Text="{Binding CityName}"
                                           Style="{StaticResource Theme.Text.Caption}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding TimeText}"
                                           Style="{StaticResource Theme.Text.Mono}"
                                           FontSize="21"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0" />
                                <TextBlock Text="{Binding DateText}"
                                           Style="{StaticResource Theme.Text.Caption}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Theme.AccentBrush}" />
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Theme.AccentSoftBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
