<Window x:Class="Lumina.UI.Wpf.Clock.TimerFullscreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="专注计时"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="{DynamicResource Theme.WallBrush}"
        TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
        TextElement.Foreground="{DynamicResource Theme.TextBrush}"
        KeyDown="OnKeyDown">
    <Grid>
        <Border Background="{DynamicResource Theme.GlowBrush}" IsHitTestVisible="False" />

        <Button Content="退出全屏"
                Style="{StaticResource Theme.Button.Ghost}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="24"
                Click="OnExitClick" />

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="LabelText"
                       HorizontalAlignment="Center"
                       FontSize="{DynamicResource Theme.FontSize.Subtitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.AccentBrush}" />

            <TextBlock x:Name="TimeText"
                       HorizontalAlignment="Center"
                       Style="{StaticResource Theme.Text.Mono}"
                       FontSize="132"
                       FontWeight="SemiBold"
                       Margin="0,12,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <Button x:Name="PlayPauseButton"
                        Content="暂停"
                        Style="{StaticResource Theme.Button.Primary}"
                        Width="120"
                        Padding="18,10"
                        Margin="0,0,12,0"
                        Click="OnPlayPauseClick" />
                <Button x:Name="MarkButton"
                        Content="标记"
                        Style="{StaticResource Theme.Button.Secondary}"
                        Width="96"
                        Padding="18,10"
                        Margin="0,0,12,0"
                        Click="OnMarkClick" />
                <Button Content="重置"
                        Style="{StaticResource Theme.Button.Secondary}"
                        Width="96"
                        Padding="18,10"
                        Click="OnResetClick" />
            </StackPanel>

            <TextBlock x:Name="EscHintText"
                       Text="连按两下 ESC 强制结束"
                       Style="{StaticResource Theme.Text.Tertiary}"
                       HorizontalAlignment="Center"
                       Margin="0,32,0,0" />
        </StackPanel>
    </Grid>
</Window>
