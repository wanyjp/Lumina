<UserControl x:Class="Lumina.UI.Wpf.Clock.WorldClockSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
             TextElement.FontSize="{DynamicResource Theme.FontSize.Body}"
             TextElement.Foreground="{DynamicResource Theme.TextBrush}"
             Background="Transparent">
    <StackPanel>
        <TextBlock Text="当前地区" Style="{StaticResource Theme.Text.Tertiary}" />
        <Grid Margin="0,6,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="RegionBox"
                      Grid.Column="0"
                      Height="40"
                      AutomationProperties.Name="世界时钟地区"
                      SelectionChanged="OnRegionChanged" />
            <Button x:Name="RemoveButton"
                    Grid.Column="1"
                    Content="移除"
                    Style="{StaticResource Theme.Button.Secondary}"
                    Margin="8,0,0,0"
                    Click="OnRemoveClick" />
        </Grid>

        <TextBlock Text="添加城市（全球首都与多时区代表城市，按首字母排序，可输入搜索）"
                   Style="{StaticResource Theme.Text.Tertiary}" />
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="CityBox"
                      Grid.Column="0"
                      Height="40"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      TextSearch.TextPath="DisplayName"
                      AutomationProperties.Name="添加城市" />
            <Button x:Name="AddButton"
                    Grid.Column="1"
                    Content="添加"
                    Style="{StaticResource Theme.Button.Primary}"
                    Margin="8,0,0,0"
                    Click="OnAddClick" />
        </Grid>

        <TextBlock x:Name="RegionHint"
                   Style="{StaticResource Theme.Text.Caption}"
                   Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
