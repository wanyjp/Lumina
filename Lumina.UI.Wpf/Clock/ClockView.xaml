<UserControl x:Class="Lumina.UI.Wpf.Clock.ClockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
             TextElement.FontSize="{DynamicResource Theme.FontSize.Body}"
             TextElement.Foreground="{DynamicResource Theme.TextBrush}"
             Background="Transparent">
    <Border Style="{StaticResource Theme.Card.Strong}" VerticalAlignment="Top">
        <StackPanel>
            <TextBlock x:Name="PeriodText"
                       HorizontalAlignment="Center"
                       FontSize="{DynamicResource Theme.FontSize.Subtitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.AccentBrush}"
                       Margin="0,0,0,8" />

            <TextBlock x:Name="TimeText"
                       HorizontalAlignment="Center"
                       Style="{StaticResource Theme.Text.Mono}"
                       FontSize="{DynamicResource Theme.FontSize.Timer}"
                       FontWeight="SemiBold" />

            <TextBlock x:Name="DateText"
                       HorizontalAlignment="Center"
                       Style="{StaticResource Theme.Text.Secondary}"
                       Margin="0,12,0,0" />

            <TextBlock x:Name="LunarText"
                       HorizontalAlignment="Center"
                       Style="{StaticResource Theme.Text.Tertiary}"
                       Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</UserControl>
