<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Lumina.UI.Wpf.Controls"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <!-- 焦点框：所有可交互控件共用，键盘可达且可见 -->
    <Style x:Key="Theme.FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border Margin="-3"
                            BorderBrush="{DynamicResource Theme.AccentBrush}"
                            BorderThickness="{DynamicResource Theme.Stroke.Thick}"
                            CornerRadius="{DynamicResource Theme.Radius.Small}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 文本基线 -->
    <Style x:Key="Theme.Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Theme.Text.Display" TargetType="TextBlock" BasedOn="{StaticResource Theme.Text.Base}">
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Display}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="52" />
    </Style>

    <Style x:Key="Theme.Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Theme.Text.Base}">
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Theme.Text.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Theme.Text.Base}">
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Subtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="Theme.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Theme.Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondaryBrush}" />
    </Style>

    <Style x:Key="Theme.Text.Tertiary" TargetType="TextBlock" BasedOn="{StaticResource Theme.Text.Base}">
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextTertiaryBrush}" />
    </Style>

    <Style x:Key="Theme.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Theme.Text.Base}">
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondaryBrush}" />
    </Style>

    <Style x:Key="Theme.Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource Theme.Text.Base}">
        <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamilyMono}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Body}" />
    </Style>

    <!-- 卡片与色板 -->
    <Style x:Key="Theme.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Theme.Stroke.Hairline}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius.Default}" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Effect" Value="{DynamicResource Theme.ShadowSoft}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Theme.Card.Strong" TargetType="Border" BasedOn="{StaticResource Theme.Card}">
        <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius.Large}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Effect" Value="{DynamicResource Theme.Shadow}" />
    </Style>

    <Style x:Key="Theme.Swatch" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Theme.Stroke.Hairline}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius.Small}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 按钮基线 -->
    <Style x:Key="Theme.Button.Base" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Body}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Theme.Radius.Small}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Button.Primary" TargetType="Button" BasedOn="{StaticResource Theme.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Theme.AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.OnAccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Theme.Button.Secondary" TargetType="Button" BasedOn="{StaticResource Theme.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Theme.CardSolidBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.FieldLineBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Theme.Stroke.Hairline}" />
    </Style>

    <Style x:Key="Theme.Button.Ghost" TargetType="Button" BasedOn="{StaticResource Theme.Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- 五档主题选择器：分段式单选 -->
    <Style x:Key="Theme.ThemeChoice" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondaryBrush}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root"
                            Background="{DynamicResource Theme.CardSolidBrush}"
                            BorderBrush="{DynamicResource Theme.BorderBrush}"
                            BorderThickness="{DynamicResource Theme.Stroke.Hairline}"
                            CornerRadius="{DynamicResource Theme.Radius.Small}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.AccentSoftBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.AccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 滚动条：细轨道 + 圆角滑块，悬停加亮；纵向 12px、横向 12px，不再使用系统箭头按钮 -->
    <ControlTemplate x:Key="Theme.ScrollBar.Vertical" TargetType="ScrollBar">
        <Grid Width="12" Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False">
                        <RepeatButton.Template>
                            <ControlTemplate TargetType="RepeatButton">
                                <Border Background="Transparent" />
                            </ControlTemplate>
                        </RepeatButton.Template>
                    </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb MinHeight="32" Cursor="Hand">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border x:Name="Bar"
                                        Margin="3,2"
                                        CornerRadius="3"
                                        Background="{DynamicResource Theme.ScrollThumbBrush}" />
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Theme.ScrollThumbHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsDragging" Value="True">
                                        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Theme.ScrollThumbHoverBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False">
                        <RepeatButton.Template>
                            <ControlTemplate TargetType="RepeatButton">
                                <Border Background="Transparent" />
                            </ControlTemplate>
                        </RepeatButton.Template>
                    </RepeatButton>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="Theme.ScrollBar.Horizontal" TargetType="ScrollBar">
        <Grid Height="12" Background="Transparent">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Focusable="False">
                        <RepeatButton.Template>
                            <ControlTemplate TargetType="RepeatButton">
                                <Border Background="Transparent" />
                            </ControlTemplate>
                        </RepeatButton.Template>
                    </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb MinWidth="32" Cursor="Hand">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border x:Name="Bar"
                                        Margin="2,3"
                                        CornerRadius="3"
                                        Background="{DynamicResource Theme.ScrollThumbBrush}" />
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Theme.ScrollThumbHoverBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Focusable="False">
                        <RepeatButton.Template>
                            <ControlTemplate TargetType="RepeatButton">
                                <Border Background="Transparent" />
                            </ControlTemplate>
                        </RepeatButton.Template>
                    </RepeatButton>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style x:Key="Theme.ScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template" Value="{StaticResource Theme.ScrollBar.Vertical}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Template" Value="{StaticResource Theme.ScrollBar.Horizontal}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource Theme.ScrollBar}" />

    <!-- 输入框 -->
    <Style x:Key="Theme.Input" TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Theme.AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource Theme.FieldBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.FieldLineBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Theme.Stroke.Hairline}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Theme.Radius.Small}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      VerticalAlignment="Stretch"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 密码框：与 Theme.Input 同一套底色与圆角，供保险库解锁/设置主密码使用 -->
    <Style x:Key="Theme.PasswordInput" TargetType="PasswordBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Theme.AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource Theme.FieldBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.FieldLineBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Theme.Stroke.Hairline}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Theme.Radius.Small}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      VerticalAlignment="Stretch"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 日期选择框：内嵌输入框使用主题底色，避免深色主题白底白字（A-129） -->
    <Style TargetType="{x:Type primitives:DatePickerTextBox}">
        <Setter Property="Background" Value="{DynamicResource Theme.FieldBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Theme.AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 日期选择器：整体贴合主题底色与描边，弹出日历再单独放大 -->
    <Style TargetType="{x:Type DatePicker}">
        <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource Theme.FieldBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.FieldLineBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Theme.Stroke.Hairline}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CalendarStyle" Value="{DynamicResource Theme.Calendar}" />
    </Style>

    <!-- 弹出日历单元格（A-142）：尺寸与主题参数合并进 Theme.CalendarDayButton / Theme.CalendarButton，
         由下方唯一的隐式 Style 经 BasedOn 引用；同一 ResourceDictionary 不得出现两个同类型隐式键。 -->

    <Style x:Key="Theme.Calendar" TargetType="{x:Type Calendar}">
        <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamily}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource Theme.CardSolidBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.FieldLineBrush}" />
        <Setter Property="Width" Value="260" />
        <Setter Property="Height" Value="260" />
        <Setter Property="MinWidth" Value="260" />
        <Setter Property="MinHeight" Value="260" />
        <Setter Property="Resources">
            <Setter.Value>
                <ResourceDictionary>
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="Transparent" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{DynamicResource Theme.Color.Text}" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{DynamicResource Theme.Color.Text}" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="{DynamicResource Theme.Color.TextTertiary}" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource Theme.Color.Accent}" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource Theme.Color.OnAccent}" />
                </ResourceDictionary>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Calendar}" BasedOn="{StaticResource Theme.Calendar}" />

    <!-- 日历单元格：日期按钮（P2-04 A-142：替换系统浅色模板，跟随主题令牌） -->
    <Style x:Key="Theme.CalendarDayButton" TargetType="{x:Type primitives:CalendarDayButton}">
        <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamily}" />
        <Setter Property="MinWidth" Value="33" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type primitives:CalendarDayButton}">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="{DynamicResource Theme.Radius.Small}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="6,4"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.AccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.AccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.TextTertiaryBrush}" />
                            <!-- 0.72 会把三级文字的实际对比度压到 3:1 左右；保留弱化但不能牺牲可读性。 -->
                            <Setter Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.TextTertiaryBrush}" />
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.TextTertiaryBrush}" />
                            <Setter Property="Opacity" Value="0.6" />
                            <Setter TargetName="Root" Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type primitives:CalendarDayButton}" BasedOn="{StaticResource Theme.CalendarDayButton}" />

    <!-- 日历单元格：年/月视图按钮 -->
    <Style x:Key="Theme.CalendarButton" TargetType="{x:Type primitives:CalendarButton}">
        <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamily}" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type primitives:CalendarButton}">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="{DynamicResource Theme.Radius.Small}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="8,10"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.AccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.AccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type primitives:CalendarButton}" BasedOn="{StaticResource Theme.CalendarButton}" />

    <!-- 日历主体：头部导航 + 月视图网格 + 年视图网格（替换系统固定浅色底） -->
    <Style x:Key="Theme.CalendarItem" TargetType="{x:Type primitives:CalendarItem}">
        <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type primitives:CalendarItem}">
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="{x:Static primitives:CalendarItem.DayTitleTemplateKey}">
                            <TextBlock Text="{Binding}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="6,6"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.TextTertiaryBrush}" />
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Grid x:Name="PART_Root">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 头部：上一年/月、标题、下一年/月 -->
                        <Grid Margin="8,8,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PART_PreviousButton"
                                    Grid.Column="0"
                                    Focusable="False"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8,5">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Root"
                                                Background="Transparent"
                                                CornerRadius="{DynamicResource Theme.Radius.Small}">
                                            <TextBlock Text="&#xE76B;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Theme.TextSecondaryBrush}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.HoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="PART_HeaderButton"
                                    Grid.Column="1"
                                    Focusable="False"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4,5">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Root"
                                                Background="Transparent"
                                                CornerRadius="{DynamicResource Theme.Radius.Small}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              TextElement.Foreground="{DynamicResource Theme.TextBrush}"
                                                              TextElement.FontWeight="SemiBold"
                                                              TextElement.FontSize="14" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.HoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="PART_NextButton"
                                    Grid.Column="2"
                                    Focusable="False"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8,5">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Root"
                                                Background="Transparent"
                                                CornerRadius="{DynamicResource Theme.Radius.Small}">
                                            <TextBlock Text="&#xE76C;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Theme.TextSecondaryBrush}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.HoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <Grid x:Name="PART_MonthView"
                              Grid.Row="1"
                              Visibility="Visible"
                              HorizontalAlignment="Center"
                              Margin="4,2,4,6" />
                        <Grid x:Name="PART_YearView"
                              Grid.Row="1"
                              Visibility="Hidden"
                              HorizontalAlignment="Center"
                              Margin="4,2,4,6" />

                        <Grid x:Name="PART_DisabledVisual" Visibility="Collapsed">
                            <Border Background="{DynamicResource Theme.ScrimSoftBrush}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Year">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Decade">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type primitives:CalendarItem}" BasedOn="{StaticResource Theme.CalendarItem}" />

    <!-- 下拉框：主题化外观（时间选择等场景） -->
    <Style x:Key="Theme.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Body}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="{DynamicResource Theme.Radius.Small}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.AccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.ComboBox" TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource Theme.FieldBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.FieldLineBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Theme.Stroke.Hairline}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Theme.ComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Root"
                                            Background="{DynamicResource Theme.FieldBrush}"
                                            BorderBrush="{DynamicResource Theme.FieldLineBrush}"
                                            BorderThickness="{DynamicResource Theme.Stroke.Hairline}"
                                            CornerRadius="{DynamicResource Theme.Radius.Small}"
                                            SnapsToDevicePixels="True" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="Selection"
                                          IsHitTestVisible="False"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />

                        <!-- 可编辑模式：默认模板没有 TextBox，导致 IsEditable 无效、选中值不回显 -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Visibility="Collapsed"
                                 Margin="10,0,30,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource Theme.TextBrush}"
                                 CaretBrush="{DynamicResource Theme.AccentBrush}"
                                 FontFamily="{DynamicResource Theme.FontFamily}"
                                 FontSize="{DynamicResource Theme.FontSize.Body}"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="&#xE70D;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Foreground="{DynamicResource Theme.TextTertiaryBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,11,0"
                                   IsHitTestVisible="False" />

                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource Theme.CardSolidBrush}"
                                    BorderBrush="{DynamicResource Theme.FieldLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Theme.Radius.Small}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="280"
                                    Margin="0,4,0,0"
                                    Effect="{DynamicResource Theme.ShadowSoft}">
                                <ScrollViewer Margin="4" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="Selection" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource Theme.ComboBox}" />

    <!-- 开关 -->
    <Style x:Key="Theme.Toggle" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="40" Height="20" VerticalAlignment="Center">
                            <Border x:Name="Track"
                                    Background="{DynamicResource Theme.LineBrush}"
                                    BorderBrush="{DynamicResource Theme.BorderBrush}"
                                    BorderThickness="{DynamicResource Theme.Stroke.Hairline}"
                                    CornerRadius="10" />
                            <Ellipse x:Name="Thumb"
                                     Width="14" Height="14"
                                     Fill="{DynamicResource Theme.TextSecondaryBrush}"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0" />
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Theme.AccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Theme.AccentBrush}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Theme.OnAccentBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 音量滑块：细轨道 + 圆形滑块，值域 0–100 -->
    <Style x:Key="Theme.Slider" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Theme.LineBrush}"
                                CornerRadius="2" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource Theme.AccentBrush}"
                                                    CornerRadius="2" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                              Focusable="False"
                                              Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="16"
                                                     Height="16"
                                                     Fill="{DynamicResource Theme.AccentBrush}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 标签 -->
    <Style x:Key="Theme.Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.AccentSoftBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius.Pill}" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- 放大态骨架：遮罩 + 居中卡片 + 圆形操作按钮 -->
    <Style x:Key="Theme.Zoom.Backdrop" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.ScrimBrush}" />
    </Style>

    <Style x:Key="Theme.Zoom.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.CardSolidBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Theme.Stroke.Hairline}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius.ExtraLarge}" />
        <Setter Property="Padding" Value="28" />
        <Setter Property="Effect" Value="{DynamicResource Theme.Shadow}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Theme.Zoom.Action" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}" />
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{DynamicResource Theme.CardSolidBrush}"
                            BorderBrush="{DynamicResource Theme.BorderBrush}"
                            BorderThickness="{DynamicResource Theme.Stroke.Hairline}"
                            CornerRadius="28"
                            Effect="{DynamicResource Theme.ShadowSoft}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 滑动操作骨架 -->
    <Style x:Key="Theme.Swipe.Item" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.LineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Theme.Swipe.Edit" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}" />
        <Setter Property="Width" Value="62" />
        <Setter Property="Background" Value="{DynamicResource Theme.EditBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.OnDangerBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Caption}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Swipe.Delete" TargetType="Button" BasedOn="{StaticResource Theme.Swipe.Edit}">
        <Setter Property="Background" Value="{DynamicResource Theme.DangerBrush}" />
    </Style>

    <!-- 剪贴板多选勾选框：18px 方框，选中填充强调色并显示对勾 -->
    <Style x:Key="Theme.Clip.Select" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="Box"
                                CornerRadius="4"
                                Background="{DynamicResource Theme.CardSolidBrush}"
                                BorderBrush="{DynamicResource Theme.BorderBrush}"
                                BorderThickness="{DynamicResource Theme.Stroke.Hairline}"
                                SnapsToDevicePixels="True" />
                        <Path x:Name="Check"
                              Data="M 2.5 6 L 5 8.5 L 9.5 3.5"
                              Stroke="{DynamicResource Theme.OnAccentBrush}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Theme.AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Theme.AccentBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 小组件圆形操作按钮：开始/暂停、标记、重置 -->
    <Style x:Key="Theme.Widget.Action" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource Theme.FieldBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            CornerRadius="17"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Theme.FieldLineBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 抽屉骨架 -->
    <Style x:Key="Theme.Drawer.Scrim" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.ScrimSoftBrush}" />
    </Style>

    <Style x:Key="Theme.Drawer.Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.CardSolidBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect" Value="{DynamicResource Theme.Shadow}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 完成风格：四套视觉模板，视图只消费 Strategy 的结果 -->
    <ControlTemplate x:Key="Completion.Stroke" TargetType="{x:Type controls:CompletionGlyph}">
        <Grid Width="20" Height="20">
            <Ellipse x:Name="Ring"
                     Fill="Transparent"
                     Stroke="{DynamicResource Theme.LineBrush}"
                     StrokeThickness="1.5" />
            <Path x:Name="Check"
                  Data="M 5 10 L 9 14 L 15 6"
                  Stroke="{DynamicResource Theme.AccentBrush}"
                  StrokeThickness="2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Done" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Theme.AccentBrush}" />
                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Completion.Fill" TargetType="{x:Type controls:CompletionGlyph}">
        <Grid Width="20" Height="20">
            <Ellipse Fill="{DynamicResource Theme.CardSolidBrush}"
                     Stroke="{DynamicResource Theme.LineBrush}"
                     StrokeThickness="1.5" />
            <Ellipse x:Name="FillCircle"
                     Fill="{DynamicResource Theme.AccentBrush}"
                     Visibility="Collapsed" />
            <Path x:Name="Check"
                  Data="M 5 10 L 9 14 L 15 6"
                  Stroke="{DynamicResource Theme.OnAccentBrush}"
                  StrokeThickness="2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Done" Value="True">
                <Setter TargetName="FillCircle" Property="Visibility" Value="Visible" />
                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Completion.Ring" TargetType="{x:Type controls:CompletionGlyph}">
        <Grid Width="20" Height="20">
            <Ellipse Stroke="{DynamicResource Theme.AccentBrush}"
                     StrokeThickness="2"
                     Fill="Transparent" />
            <Ellipse x:Name="Center"
                     Width="10"
                     Height="10"
                     Fill="{DynamicResource Theme.AccentBrush}"
                     Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Done" Value="True">
                <Setter TargetName="Center" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Completion.Dot" TargetType="{x:Type controls:CompletionGlyph}">
        <Grid Width="20" Height="20">
            <Ellipse x:Name="Outline"
                     Width="12"
                     Height="12"
                     Fill="Transparent"
                     Stroke="{DynamicResource Theme.LineBrush}"
                     StrokeThickness="1.5" />
            <Ellipse x:Name="Dot"
                     Width="8"
                     Height="8"
                     Fill="{DynamicResource Theme.AccentBrush}"
                     Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Done" Value="True">
                <Setter TargetName="Outline" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Theme.Completion" TargetType="{x:Type controls:CompletionGlyph}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template" Value="{StaticResource Completion.Stroke}" />
        <Setter Property="Focusable" Value="False" />
        <Style.Triggers>
            <Trigger Property="CompletionStyle" Value="Fill">
                <Setter Property="Template" Value="{StaticResource Completion.Fill}" />
            </Trigger>
            <Trigger Property="CompletionStyle" Value="Ring">
                <Setter Property="Template" Value="{StaticResource Completion.Ring}" />
            </Trigger>
            <Trigger Property="CompletionStyle" Value="Dot">
                <Setter Property="Template" Value="{StaticResource Completion.Dot}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.CompletionCheck" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Background="Transparent"
                            Padding="4"
                            CornerRadius="{DynamicResource Theme.Radius.Small}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
