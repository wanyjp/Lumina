<UserControl x:Class="Lumina.UI.Wpf.Clipboard.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
             TextElement.FontSize="{DynamicResource Theme.FontSize.Body}"
             TextElement.Foreground="{DynamicResource Theme.TextBrush}"
             Background="Transparent"
             Focusable="True">

    <Border x:Name="PageCard" Style="{StaticResource Theme.Card.Strong}" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题与全局操作 -->
            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock x:Name="HeaderTitleText" Text="剪贴板历史" Style="{StaticResource Theme.Text.SectionTitle}" Margin="0" />
                    <TextBlock x:Name="SummaryText" Style="{StaticResource Theme.Text.Caption}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Button x:Name="FloatButton"
                            Content="浮窗"
                            Style="{StaticResource Theme.Button.Ghost}"
                            Padding="10,5,10,5"
                            FontSize="12"
                            Margin="0,0,6,0"
                            ToolTip="打开剪贴板浮窗（Ctrl + Alt + V）"
                            Click="OnFloatClick" />
                    <Button x:Name="SelectModeButton"
                            Content="多选"
                            Style="{StaticResource Theme.Button.Secondary}"
                            Padding="12,5,12,5"
                            FontSize="12"
                            Click="OnSelectModeClick" />
                </StackPanel>
            </Grid>

            <!-- 分类页签 -->
            <WrapPanel x:Name="TabBar" Grid.Row="1" Margin="0,12,0,0" />

            <!-- 搜索 -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource Theme.Input}"
                         Padding="30,7,30,7"
                         HorizontalContentAlignment="Left"
                         TextAlignment="Left"
                         ToolTip="搜索正文、备注、标签或来源"
                         TextChanged="OnSearchTextChanged"
                         PreviewKeyDown="OnSearchKeyDown"
                         GotFocus="OnSearchFocusChanged"
                         LostFocus="OnSearchFocusChanged" />
                <!-- 占位文字只在空且未聚焦时显示：聚焦后隐藏，避免插入符与提示文字重叠成「光标跑到字中间」。 -->
                <TextBlock x:Name="SearchPlaceholder"
                           Text="搜索正文、备注、标签或来源…"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="32,0,0,0"
                           Style="{StaticResource Theme.Text.Tertiary}" />
                <TextBlock Text="&#xE721;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="12"
                           Foreground="{DynamicResource Theme.TextTertiaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Margin="11,0,0,0"
                           IsHitTestVisible="False" />
                <Button x:Name="ClearSearchButton"
                        Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Style="{StaticResource Theme.Button.Ghost}"
                        Padding="6,2,6,2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0"
                        ToolTip="清除搜索"
                        Visibility="Collapsed"
                        Click="OnClearSearchClick" />
            </Grid>

            <!-- 标签筛选（可在设置中隐藏） -->
            <StackPanel x:Name="TagFilterPanel" Grid.Row="3" Margin="0,10,0,0">
                <WrapPanel x:Name="TagBar" />
            </StackPanel>

            <!-- 多选工具条 -->
            <Border x:Name="SelectionBar"
                    Grid.Row="4"
                    Background="{DynamicResource Theme.AccentSoftBrush}"
                    CornerRadius="{DynamicResource Theme.Radius.Small}"
                    Padding="10,6"
                    Margin="0,10,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectionText"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Theme.AccentBrush}"
                                   FontSize="12" />
                        <Button Content="全选"
                                Style="{StaticResource Theme.Button.Ghost}"
                                Padding="8,3,8,3"
                                FontSize="12"
                                Margin="10,0,0,0"
                                Click="OnSelectAllClick" />
                        <Button x:Name="DeleteSelectedButton"
                                Content="删除所选"
                                Style="{StaticResource Theme.Button.Ghost}"
                                Padding="8,3,8,3"
                                FontSize="12"
                                Foreground="{DynamicResource Theme.DangerBrush}"
                                Margin="6,0,0,0"
                                Click="OnDeleteSelectedClick" />
                    </StackPanel>
                    <Button Content="取消"
                            Style="{StaticResource Theme.Button.Ghost}"
                            Padding="8,3,8,3"
                            FontSize="12"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="OnCancelSelectionClick" />
                </Grid>
            </Border>

            <!-- 列表与空态 -->
            <Grid Grid.Row="5" Margin="0,10,0,0">
                <ScrollViewer x:Name="ListScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="True"
                              FocusVisualStyle="{x:Null}">
                    <StackPanel x:Name="CardList" />
                </ScrollViewer>

                <StackPanel x:Name="EmptyPanel"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MaxWidth="420"
                            Visibility="Collapsed">
                    <TextBlock x:Name="EmptyGlyph"
                               Text="&#xE77F;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="34"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Theme.AccentBrush}" />
                    <TextBlock x:Name="EmptyTitle"
                               Style="{StaticResource Theme.Text.Base}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,12,0,0" />
                    <TextBlock x:Name="EmptyBody"
                               Style="{StaticResource Theme.Text.Tertiary}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                    <Button x:Name="EmptyAction"
                            Style="{StaticResource Theme.Button.Secondary}"
                            Padding="12,5,12,5"
                            FontSize="12"
                            HorizontalAlignment="Center"
                            Margin="0,14,0,0"
                            Visibility="Collapsed"
                            Click="OnEmptyActionClick" />
                </StackPanel>
            </Grid>

            <!-- 状态与键盘提示 -->
            <Grid Grid.Row="6" Margin="0,8,0,0">
                <TextBlock x:Name="StatusText" Style="{StaticResource Theme.Text.Tertiary}" />
                <TextBlock Text="↑↓ 选择 · Enter 展开 · Delete 删除 · Esc 返回"
                           Style="{StaticResource Theme.Text.Tertiary}"
                           HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
