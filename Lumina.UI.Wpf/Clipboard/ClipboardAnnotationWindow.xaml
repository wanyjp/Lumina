<Window x:Class="Lumina.UI.Wpf.Clipboard.ClipboardAnnotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="备注与标签"
        Width="520"
        SizeToContent="Height"
        MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.CardSolidBrush}"
        TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
        TextElement.FontSize="{DynamicResource Theme.FontSize.Body}"
        TextElement.Foreground="{DynamicResource Theme.TextBrush}">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="备注与标签" Style="{StaticResource Theme.Text.Title}" Margin="0,0,0,6" />
            <TextBlock x:Name="PreviewText"
                       Style="{StaticResource Theme.Text.Tertiary}"
                       TextTrimming="CharacterEllipsis"
                       MaxHeight="36"
                       Margin="0,0,0,16" />

            <TextBlock Text="备注" Style="{StaticResource Theme.Text.Caption}" />
            <TextBox x:Name="NoteBox"
                     Style="{StaticResource Theme.Input}"
                     Height="112"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,4,0,14" />

            <TextBlock Text="标签" Style="{StaticResource Theme.Text.Caption}" />
            <TextBox x:Name="TagsBox"
                     Style="{StaticResource Theme.Input}"
                     Margin="0,4,0,6"
                     TextChanged="OnTagsChanged" />
            <TextBlock Text="用逗号或空格分隔；最多 5 个，每个最多 12 字，超出部分自动截断。"
                       Style="{StaticResource Theme.Text.Tertiary}" />

            <WrapPanel x:Name="ChipPreview" Margin="0,10,0,0" />

            <TextBlock x:Name="CounterText"
                       Style="{StaticResource Theme.Text.Tertiary}"
                       Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消"
                        Style="{StaticResource Theme.Button.Ghost}"
                        Margin="0,0,8,0"
                        Click="OnCancelClick" />
                <Button Content="保存"
                        Style="{StaticResource Theme.Button.Primary}"
                        Click="OnSaveClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
