<Window x:Class="Lumina.UI.Wpf.Clipboard.ClipboardSourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="来源"
        Width="480"
        SizeToContent="Height"
        MaxHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.CardSolidBrush}"
        TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
        TextElement.FontSize="{DynamicResource Theme.FontSize.Body}"
        TextElement.Foreground="{DynamicResource Theme.TextBrush}">
    <StackPanel Margin="22">
        <TextBlock Text="来源记录" Style="{StaticResource Theme.Text.Title}" />
        <TextBlock Text="按最近一次复制排序；同一条记录最多保留 8 个来源。"
                   Style="{StaticResource Theme.Text.Tertiary}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0" />

        <Border Background="{DynamicResource Theme.WallSecondaryBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}"
                BorderThickness="{DynamicResource Theme.Stroke.Hairline}"
                CornerRadius="{DynamicResource Theme.Radius.Small}"
                Padding="6"
                Margin="0,12,0,0">
            <ScrollViewer MaxHeight="380"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SourceList" />
            </ScrollViewer>
        </Border>

        <Button Content="关闭"
                Style="{StaticResource Theme.Button.Secondary}"
                HorizontalAlignment="Right"
                Padding="16,7"
                Margin="0,14,0,0"
                Click="OnCloseClick" />
    </StackPanel>
</Window>
