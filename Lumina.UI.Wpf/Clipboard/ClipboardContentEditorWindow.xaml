<Window x:Class="Lumina.UI.Wpf.Clipboard.ClipboardContentEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑剪贴板内容"
        Width="640"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.CardSolidBrush}"
        TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
        TextElement.FontSize="{DynamicResource Theme.FontSize.Body}"
        TextElement.Foreground="{DynamicResource Theme.TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="编辑内容" Style="{StaticResource Theme.Text.Title}" />
        <TextBlock x:Name="KindHint"
                   Grid.Row="1"
                   Style="{StaticResource Theme.Text.Tertiary}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,12" />

        <TextBox x:Name="ContentBox"
                 Grid.Row="2"
                 Style="{StaticResource Theme.Input}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 Padding="10" />

        <TextBlock Grid.Row="3"
                   Text="保存后按新内容重新判定类型：整段 http/https 链接归为链接，否则归为文本；HTML 条目保持 HTML。"
                   Style="{StaticResource Theme.Text.Tertiary}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="ErrorText"
                       Foreground="{DynamicResource Theme.DangerBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消"
                        Style="{StaticResource Theme.Button.Ghost}"
                        Margin="0,0,8,0"
                        Click="OnCancelClick" />
                <Button Content="保存"
                        Style="{StaticResource Theme.Button.Primary}"
                        Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
