<UserControl x:Class="Lumina.UI.Wpf.Views.ThemeGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
             TextElement.FontSize="{DynamicResource Theme.FontSize.Body}"
             TextElement.Foreground="{DynamicResource Theme.TextBrush}"
             Background="Transparent">

    <Grid>
        <Border Background="{DynamicResource Theme.WallBrush}" />
        <Border Background="{DynamicResource Theme.GlowBrush}" IsHitTestVisible="False" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Padding="40,28,40,40">
                <StackPanel Width="1000" HorizontalAlignment="Center">

                    <!-- 标题 -->
                    <Grid Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="拾光" Style="{StaticResource Theme.Text.Display}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Style="{StaticResource Theme.Chip}" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="Lumina"
                                               FontSize="{DynamicResource Theme.FontSize.Caption}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Theme.AccentBrush}" />
                                </Border>
                                <TextBlock Text="设计系统与五档主题 · P0-05"
                                           Style="{StaticResource Theme.Text.Secondary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="ThemeStatusText"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Style="{StaticResource Theme.Text.Base}"
                                   FontSize="{DynamicResource Theme.FontSize.Small}"
                                   FontWeight="SemiBold" />
                    </Grid>

                    <!-- 五档主题 -->
                    <Border Style="{StaticResource Theme.Card.Strong}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="五档主题" Style="{StaticResource Theme.Text.SectionTitle}" />
                            <WrapPanel x:Name="ThemeChoicesPanel" />
                            <TextBlock Text="跟随系统会监听 Windows 应用模式；手动选档后以手动值为准，重新选择“跟随系统”恢复监听。所选档位写入 app_setting，重启后保持。"
                                       Style="{StaticResource Theme.Text.Tertiary}"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 色板 / 字体与形状 -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Theme.Card}">
                            <StackPanel>
                                <TextBlock Text="色板令牌" Style="{StaticResource Theme.Text.SectionTitle}" />
                                <WrapPanel>
                                    <StackPanel Width="108" Margin="0,0,10,12">
                                        <Border Height="42" Style="{StaticResource Theme.Swatch}" Background="{DynamicResource Theme.AccentBrush}" />
                                        <TextBlock Text="Accent" Style="{StaticResource Theme.Text.Caption}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Width="108" Margin="0,0,10,12">
                                        <Border Height="42" Style="{StaticResource Theme.Swatch}" Background="{DynamicResource Theme.AccentSecondaryBrush}" />
                                        <TextBlock Text="Accent 2" Style="{StaticResource Theme.Text.Caption}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Width="108" Margin="0,0,10,12">
                                        <Border Height="42" Style="{StaticResource Theme.Swatch}" Background="{DynamicResource Theme.AccentSoftBrush}" />
                                        <TextBlock Text="Accent Soft" Style="{StaticResource Theme.Text.Caption}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Width="108" Margin="0,0,10,12">
                                        <Border Height="42" Style="{StaticResource Theme.Swatch}" Background="{DynamicResource Theme.WallBrush}" />
                                        <TextBlock Text="Wall" Style="{StaticResource Theme.Text.Caption}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Width="108" Margin="0,0,10,12">
                                        <Border Height="42" Style="{StaticResource Theme.Swatch}" Background="{DynamicResource Theme.CardBrush}" />
                                        <TextBlock Text="Card" Style="{StaticResource Theme.Text.Caption}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Width="108" Margin="0,0,10,12">
                                        <Border Height="42" Style="{StaticResource Theme.Swatch}" Background="{DynamicResource Theme.CardSolidBrush}" />
                                        <TextBlock Text="Card Solid" Style="{StaticResource Theme.Text.Caption}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Width="108" Margin="0,0,10,12">
                                        <Border Height="42" Style="{StaticResource Theme.Swatch}" Background="{DynamicResource Theme.LineBrush}" />
                                        <TextBlock Text="Line" Style="{StaticResource Theme.Text.Caption}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Width="108" Margin="0,0,10,12">
                                        <Border Height="42" Style="{StaticResource Theme.Swatch}" Background="{DynamicResource Theme.BorderBrush}" />
                                        <TextBlock Text="Border" Style="{StaticResource Theme.Text.Caption}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Width="108" Margin="0,0,10,12">
                                        <Border Height="42" Style="{StaticResource Theme.Swatch}" Background="{DynamicResource Theme.TextBrush}" />
                                        <TextBlock Text="Text" Style="{StaticResource Theme.Text.Caption}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Width="108" Margin="0,0,10,12">
                                        <Border Height="42" Style="{StaticResource Theme.Swatch}" Background="{DynamicResource Theme.TextSecondaryBrush}" />
                                        <TextBlock Text="Text 2" Style="{StaticResource Theme.Text.Caption}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Width="108" Margin="0,0,10,12">
                                        <Border Height="42" Style="{StaticResource Theme.Swatch}" Background="{DynamicResource Theme.EditBrush}" />
                                        <TextBlock Text="Edit" Style="{StaticResource Theme.Text.Caption}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Width="108" Margin="0,0,10,12">
                                        <Border Height="42" Style="{StaticResource Theme.Swatch}" Background="{DynamicResource Theme.DangerBrush}" />
                                        <TextBlock Text="Danger" Style="{StaticResource Theme.Text.Caption}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Theme.Card}">
                            <StackPanel>
                                <TextBlock Text="字体与形状" Style="{StaticResource Theme.Text.SectionTitle}" />
                                <TextBlock Text="12:34:56"
                                           Style="{StaticResource Theme.Text.Mono}"
                                           FontSize="{DynamicResource Theme.FontSize.Clock}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="标题文字 · Title" Style="{StaticResource Theme.Text.Title}" Margin="0,10,0,0" />
                                <TextBlock Text="正文示例：本地优先、轻量克制，颜色不作为唯一状态载体。"
                                           Style="{StaticResource Theme.Text.Secondary}"
                                           Margin="0,6,0,0" />
                                <TextBlock Text="说明文字 · Caption" Style="{StaticResource Theme.Text.Caption}" Margin="0,8,0,0" />
                                <TextBlock Text="辅助信息 · Tertiary" Style="{StaticResource Theme.Text.Tertiary}" Margin="0,4,0,0" />
                                <TextBlock Text="1,234.56 · 等宽数字" Style="{StaticResource Theme.Text.Mono}" Margin="0,8,0,0" />

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <StackPanel Width="88" Margin="0,0,10,0">
                                        <Border Height="44"
                                                Style="{StaticResource Theme.Card}"
                                                Background="{DynamicResource Theme.AccentSoftBrush}"
                                                BorderBrush="{DynamicResource Theme.AccentBrush}"
                                                CornerRadius="{DynamicResource Theme.Radius.Small}"
                                                Padding="0" />
                                        <TextBlock Text="圆角 · 小" Style="{StaticResource Theme.Text.Caption}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Width="88" Margin="0,0,10,0">
                                        <Border Height="44"
                                                Style="{StaticResource Theme.Card}"
                                                Background="{DynamicResource Theme.AccentSoftBrush}"
                                                BorderBrush="{DynamicResource Theme.AccentBrush}"
                                                CornerRadius="{DynamicResource Theme.Radius.Default}"
                                                Padding="0" />
                                        <TextBlock Text="圆角 · 中" Style="{StaticResource Theme.Text.Caption}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Width="88" Margin="0,0,10,0">
                                        <Border Height="44"
                                                Style="{StaticResource Theme.Card}"
                                                Background="{DynamicResource Theme.AccentSoftBrush}"
                                                BorderBrush="{DynamicResource Theme.AccentBrush}"
                                                CornerRadius="{DynamicResource Theme.Radius.Large}"
                                                Padding="0"
                                                Effect="{DynamicResource Theme.Shadow}" />
                                        <TextBlock Text="圆角 · 大 + 阴影" Style="{StaticResource Theme.Text.Caption}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 组件基线 -->
                    <Border Style="{StaticResource Theme.Card}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="组件基线" Style="{StaticResource Theme.Text.SectionTitle}" />
                            <WrapPanel>
                                <Button Content="主要操作" Style="{StaticResource Theme.Button.Primary}" Margin="0,0,10,10" />
                                <Button Content="次要操作" Style="{StaticResource Theme.Button.Secondary}" Margin="0,0,10,10" />
                                <Button Content="文字按钮" Style="{StaticResource Theme.Button.Ghost}" Margin="0,0,10,10" />
                                <Border Style="{StaticResource Theme.Chip}" Margin="0,0,10,10" VerticalAlignment="Center">
                                    <TextBlock Text="标签 Chip"
                                               FontSize="{DynamicResource Theme.FontSize.Caption}"
                                               Foreground="{DynamicResource Theme.AccentBrush}" />
                                </Border>
                                <TextBox Text="搜索或输入…" Style="{StaticResource Theme.Input}" Width="200" Margin="0,0,10,10" />
                                <CheckBox Content="专注提醒" Style="{StaticResource Theme.Toggle}" IsChecked="True" Margin="0,0,16,10" />
                                <CheckBox Content="系统通知" Style="{StaticResource Theme.Toggle}" Margin="0,0,10,10" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 跨模块组件骨架 -->
                    <Border Style="{StaticResource Theme.Card}">
                        <StackPanel>
                            <TextBlock Text="跨模块组件骨架" Style="{StaticResource Theme.Text.SectionTitle}" />
                            <WrapPanel>

                                <StackPanel Width="300" Margin="0,0,16,12">
                                    <TextBlock Text="放大态 · ZoomOverlay" Style="{StaticResource Theme.Text.Secondary}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Grid Height="210">
                                        <Border Style="{StaticResource Theme.Zoom.Backdrop}" CornerRadius="{DynamicResource Theme.Radius.Default}" />
                                        <Border Style="{StaticResource Theme.Zoom.Card}"
                                                Width="200"
                                                Padding="18"
                                                Margin="12,0,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <StackPanel>
                                                <TextBlock Text="放大态卡片" Style="{StaticResource Theme.Text.Title}" FontSize="{DynamicResource Theme.FontSize.Subtitle}" />
                                                <TextBlock Text="承载便签或倒计时的完整内容。"
                                                           Style="{StaticResource Theme.Text.Secondary}"
                                                           FontSize="{DynamicResource Theme.FontSize.Small}"
                                                           Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Vertical"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,10,0">
                                            <Button Content="编辑" Style="{StaticResource Theme.Zoom.Action}" Margin="0,0,0,8" />
                                            <Button Content="关闭" Style="{StaticResource Theme.Zoom.Action}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Width="300" Margin="0,0,16,12">
                                    <TextBlock Text="滑动操作 · SwipeActionItem" Style="{StaticResource Theme.Text.Secondary}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Grid Height="56">
                                        <Border Style="{StaticResource Theme.Swipe.Item}" Margin="0,0,124,0">
                                            <TextBlock Text="整理本周日程" Style="{StaticResource Theme.Text.Base}" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="编辑" Style="{StaticResource Theme.Swipe.Edit}" />
                                            <Button Content="删除" Style="{StaticResource Theme.Swipe.Delete}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="滑动后露出编辑与删除操作，固定条目不可删除。"
                                               Style="{StaticResource Theme.Text.Tertiary}"
                                               Margin="0,8,0,0" />
                                </StackPanel>

                                <StackPanel Width="300" Margin="0,0,0,12">
                                    <TextBlock Text="功能抽屉 · ModuleDrawerHost" Style="{StaticResource Theme.Text.Secondary}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Grid Height="210" ClipToBounds="True">
                                        <Border Style="{StaticResource Theme.Drawer.Scrim}" CornerRadius="{DynamicResource Theme.Radius.Default}" />
                                        <Border Style="{StaticResource Theme.Drawer.Panel}" Width="200" HorizontalAlignment="Right">
                                            <StackPanel>
                                                <TextBlock Text="模块设置" Style="{StaticResource Theme.Text.Title}" FontSize="{DynamicResource Theme.FontSize.Subtitle}" />
                                                <TextBlock Text="仅当前模块设置，全局偏好前往设置中心。"
                                                           Style="{StaticResource Theme.Text.Tertiary}"
                                                           Margin="0,4,0,12" />
                                                <TextBlock Text="完成风格" Style="{StaticResource Theme.Text.Caption}" />
                                                <Border Background="{DynamicResource Theme.CardSolidBrush}"
                                                        BorderBrush="{DynamicResource Theme.BorderBrush}"
                                                        BorderThickness="{DynamicResource Theme.Stroke.Hairline}"
                                                        CornerRadius="{DynamicResource Theme.Radius.Small}"
                                                        Padding="8,6"
                                                        Margin="0,4,0,0">
                                                    <TextBlock Text="描边 Doodle" Style="{StaticResource Theme.Text.Secondary}" FontSize="{DynamicResource Theme.FontSize.Small}" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>

                            </WrapPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
