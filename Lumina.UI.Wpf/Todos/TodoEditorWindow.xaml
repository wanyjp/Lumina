<Window x:Class="Lumina.UI.Wpf.Todos.TodoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办"
        Width="580"
        SizeToContent="Height"
        MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.CardSolidBrush}"
        TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
        TextElement.FontSize="{DynamicResource Theme.FontSize.Body}"
        TextElement.Foreground="{DynamicResource Theme.TextBrush}">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Style="{StaticResource Theme.Text.Title}" Margin="0,0,0,16" />

            <TextBlock Text="标题" Style="{StaticResource Theme.Text.Caption}" />
            <TextBox x:Name="TextBox"
                     Style="{StaticResource Theme.Input}"
                     Margin="0,4,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="截止日期（可空）" Style="{StaticResource Theme.Text.Caption}" />
                    <DatePicker x:Name="DueDatePicker"
                                SelectedDateFormat="Short"
                                Height="40"
                                Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="截止时间（可空）" Style="{StaticResource Theme.Text.Caption}" />
                    <ComboBox x:Name="DueTimeBox"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              Height="40"
                              Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock Text="选择“不设置”= 仅日期；设置时间需先设置日期。时间可直接输入任意 HH:mm，也可从下拉建议中选择。"
                       Style="{StaticResource Theme.Text.Tertiary}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,12" />

            <TextBlock Text="优先级" Style="{StaticResource Theme.Text.Caption}" />
            <WrapPanel x:Name="PriorityPanel" Margin="0,4,0,10" />

            <TextBlock Text="备注" Style="{StaticResource Theme.Text.Caption}" />
            <TextBox x:Name="NoteBox"
                     Style="{StaticResource Theme.Input}"
                     Height="112"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,4,0,10" />

            <TextBlock x:Name="ErrorText"
                       Foreground="{DynamicResource Theme.DangerBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="取消"
                        Style="{StaticResource Theme.Button.Ghost}"
                        Margin="0,0,8,0"
                        Click="OnCancelClick" />
                <Button Content="保存"
                        Style="{StaticResource Theme.Button.Primary}"
                        Click="OnSaveClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
