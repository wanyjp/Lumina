<UserControl x:Class="Lumina.UI.Wpf.Todos.TodoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
             TextElement.FontSize="{DynamicResource Theme.FontSize.Body}"
             TextElement.Foreground="{DynamicResource Theme.TextBrush}"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Style="{StaticResource Theme.Card.Strong}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="待办" Style="{StaticResource Theme.Text.SectionTitle}" Margin="0" />
                            <TextBlock x:Name="CompletionText"
                                       Style="{StaticResource Theme.Text.Caption}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Content="＋ 新建待办"
                                Style="{StaticResource Theme.Button.Primary}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Click="OnAddClick" />
                    </Grid>

                    <WrapPanel x:Name="FilterBar" Margin="0,12,0,4" />

                    <Border Height="1"
                            Background="{DynamicResource Theme.LineBrush}"
                            Margin="0,4,0,10" />

                    <ScrollViewer x:Name="ListScroll"
                                  MaxHeight="560"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TodoList" />
                    </ScrollViewer>

                    <TextBlock x:Name="FooterText"
                               Style="{StaticResource Theme.Text.Tertiary}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
