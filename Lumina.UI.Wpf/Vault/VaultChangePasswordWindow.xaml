<Window x:Class="Lumina.UI.Wpf.Vault.VaultChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Lumina.UI.Wpf.Controls"
        Title="修改主密码"
        Width="520"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.CardSolidBrush}"
        TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
        TextElement.FontSize="{DynamicResource Theme.FontSize.Body}"
        TextElement.Foreground="{DynamicResource Theme.TextBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="修改主密码" Style="{StaticResource Theme.Text.Title}" />
        <TextBlock Text="验证当前主密码后设置新密码，库内条目会用新密码重新加密。"
                   Style="{StaticResource Theme.Text.Secondary}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0" />

        <TextBlock Text="当前主密码"
                   Style="{StaticResource Theme.Text.Caption}"
                   Margin="0,16,0,4" />
        <controls:RevealPasswordBox x:Name="CurrentPasswordBox" InputName="当前主密码" />

        <TextBlock Text="新的主密码"
                   Style="{StaticResource Theme.Text.Caption}"
                   Margin="0,12,0,4" />
        <controls:RevealPasswordBox x:Name="NewPasswordBox" InputName="新的主密码" />

        <TextBlock Text="确认新的主密码"
                   Style="{StaticResource Theme.Text.Caption}"
                   Margin="0,10,0,4" />
        <controls:RevealPasswordBox x:Name="ConfirmPasswordBox" InputName="确认新的主密码" />

        <TextBlock x:Name="ErrorText"
                   Foreground="{DynamicResource Theme.DangerBrush}"
                   Style="{StaticResource Theme.Text.Caption}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="取消"
                    Style="{StaticResource Theme.Button.Secondary}"
                    Padding="16,7"
                    Click="OnCancelClick" />
            <Button x:Name="SaveButton"
                    Content="保存"
                    Style="{StaticResource Theme.Button.Primary}"
                    Padding="16,7"
                    Margin="10,0,0,0"
                    Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
