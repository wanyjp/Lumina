<Window x:Class="Lumina.UI.Wpf.Vault.PasswordGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码生成器"
        Width="460"
        Height="540"
        MinWidth="420"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.CardSolidBrush}"
        TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
        TextElement.FontSize="{DynamicResource Theme.FontSize.Body}"
        TextElement.Foreground="{DynamicResource Theme.TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="密码生成器"
                   Style="{StaticResource Theme.Text.Title}" />

        <Border Grid.Row="1"
                Background="{DynamicResource Theme.FieldBrush}"
                CornerRadius="8"
                Padding="12"
                Margin="0,14,0,0">
            <TextBox x:Name="ResultBox"
                     Style="{StaticResource Theme.Input}"
                     IsReadOnly="True"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     FontFamily="Consolas"
                     FontSize="18"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     AutomationProperties.Name="生成的密码" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Border x:Name="Strength1"
                    Width="34"
                    Height="4"
                    CornerRadius="2"
                    Margin="0,0,4,0"
                    Background="{DynamicResource Theme.LineBrush}"
                    VerticalAlignment="Center" />
            <Border x:Name="Strength2"
                    Width="34"
                    Height="4"
                    CornerRadius="2"
                    Margin="0,0,4,0"
                    Background="{DynamicResource Theme.LineBrush}"
                    VerticalAlignment="Center" />
            <Border x:Name="Strength3"
                    Width="34"
                    Height="4"
                    CornerRadius="2"
                    Margin="0,0,4,0"
                    Background="{DynamicResource Theme.LineBrush}"
                    VerticalAlignment="Center" />
            <Border x:Name="Strength4"
                    Width="34"
                    Height="4"
                    CornerRadius="2"
                    Background="{DynamicResource Theme.LineBrush}"
                    VerticalAlignment="Center" />
            <TextBlock x:Name="StrengthLabel"
                       Text="—"
                       Style="{StaticResource Theme.Text.Caption}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <CheckBox x:Name="UppercaseBox"
                      Content="包含大写字母"
                      AutomationProperties.Name="包含大写字母"
                      Style="{StaticResource Theme.Toggle}"
                      IsChecked="True"
                      Margin="0,0,0,8"
                      Checked="OnOptionChanged"
                      Unchecked="OnOptionChanged" />
            <CheckBox x:Name="DigitsBox"
                      Content="包含数字"
                      AutomationProperties.Name="包含数字"
                      Style="{StaticResource Theme.Toggle}"
                      IsChecked="True"
                      Margin="0,0,0,8"
                      Checked="OnOptionChanged"
                      Unchecked="OnOptionChanged" />
            <CheckBox x:Name="SymbolsBox"
                      Content="包含符号"
                      AutomationProperties.Name="包含符号"
                      Style="{StaticResource Theme.Toggle}"
                      IsChecked="True"
                      Checked="OnOptionChanged"
                      Unchecked="OnOptionChanged" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="长度"
                       Style="{StaticResource Theme.Text.Caption}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="LengthText"
                       Text="16"
                       Style="{StaticResource Theme.Text.Caption}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
            <Slider x:Name="LengthSlider"
                    Grid.Row="1"
                    Style="{StaticResource Theme.Slider}"
                    Minimum="8"
                    Maximum="64"
                    Value="16"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    AutomationProperties.Name="密码长度"
                    Margin="0,6,0,0"
                    ValueChanged="OnLengthChanged" />
        </Grid>

        <Grid Grid.Row="6" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText"
                       Style="{StaticResource Theme.Text.Caption}"
                       VerticalAlignment="Center"
                       Margin="0,0,250,0" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Content="重新生成"
                        AutomationProperties.Name="重新生成密码"
                        Style="{StaticResource Theme.Button.Ghost}"
                        Padding="12,6"
                        Click="OnRegenerate" />
                <Button Content="复制"
                        AutomationProperties.Name="复制生成的密码"
                        Style="{StaticResource Theme.Button.Ghost}"
                        Padding="12,6"
                        Margin="8,0,0,0"
                        Click="OnCopy" />
                <Button Content="使用此密码"
                        AutomationProperties.Name="使用此密码"
                        Style="{StaticResource Theme.Button.Primary}"
                        Padding="14,6"
                        Margin="8,0,0,0"
                        Click="OnUse" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
