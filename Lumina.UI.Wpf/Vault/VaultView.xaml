<UserControl x:Class="Lumina.UI.Wpf.Vault.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lumina.UI.Wpf.Controls"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Theme.Card.Strong}" Padding="18">
            <Grid>
                <StackPanel>
                    <TextBlock Text="密码管理器"
                               Style="{StaticResource Theme.Text.SectionTitle}" />
                    <TextBlock x:Name="SummaryLine"
                               Text="本地加密 · 自动锁定"
                               Style="{StaticResource Theme.Text.Tertiary}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel x:Name="HeaderActions"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="StatusText"
                               Style="{StaticResource Theme.Text.Caption}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Button x:Name="GeneratorButton"
                            Content="密码生成器"
                            AutomationProperties.Name="密码生成器"
                            Style="{StaticResource Theme.Button.Ghost}"
                            Padding="12,6"
                            Click="OnGenerateClick" />
                    <Button x:Name="AddButton"
                            Content="新增条目"
                            AutomationProperties.Name="新增条目"
                            Style="{StaticResource Theme.Button.Primary}"
                            Padding="12,6"
                            Margin="8,0,0,0"
                            Click="OnAddClick" />
                    <Button x:Name="LockButton"
                            Content="立即锁定"
                            AutomationProperties.Name="立即锁定保险库"
                            Style="{StaticResource Theme.Button.Ghost}"
                            Padding="12,6"
                            Margin="8,0,0,0"
                            Click="OnLockClick" />
                    <Button x:Name="ChangePasswordButton"
                            Content="修改主密码"
                            AutomationProperties.Name="修改主密码"
                            Style="{StaticResource Theme.Button.Ghost}"
                            Padding="12,6"
                            Margin="8,0,0,0"
                            Click="OnChangePasswordClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">

            <!-- 首次运行：设置主密码；窗口较矮时纵向滚动，保证底部按钮可达 -->
            <ScrollViewer x:Name="SetupScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
            <Border x:Name="SetupCard"
                    Style="{StaticResource Theme.Card}"
                    Padding="28"
                    VerticalAlignment="Top">
                <StackPanel MaxWidth="420"
                            HorizontalAlignment="Center">
                    <Border Width="64"
                            Height="64"
                            CornerRadius="32"
                            Background="{DynamicResource Theme.AccentSoftBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="26"
                                   Foreground="{DynamicResource Theme.AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="创建保险库"
                               Style="{StaticResource Theme.Text.Title}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,6" />
                    <TextBlock Text="设置一个主密码。它只在本机用于派生加密密钥，不会上传。"
                               Style="{StaticResource Theme.Text.Secondary}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />

                    <TextBlock Text="主密码"
                               Style="{StaticResource Theme.Text.Caption}"
                               HorizontalAlignment="Left"
                               Margin="0,18,0,4" />
                    <controls:RevealPasswordBox x:Name="SetupPasswordBox"
                                                InputName="设置主密码"
                                                HorizontalAlignment="Stretch" />

                    <TextBlock Text="确认密码"
                               Style="{StaticResource Theme.Text.Caption}"
                               HorizontalAlignment="Left"
                               Margin="0,10,0,4" />
                    <controls:RevealPasswordBox x:Name="SetupConfirmBox"
                                                InputName="确认主密码"
                                                HorizontalAlignment="Stretch" />

                    <TextBlock Text="安全问题（用于忘记主密码时找回）"
                               Style="{StaticResource Theme.Text.Caption}"
                               HorizontalAlignment="Left"
                               Margin="0,10,0,4" />
                    <ComboBox x:Name="SetupQuestionBox"
                              Height="40"
                              IsEditable="True"
                              AutomationProperties.Name="安全问题"
                              Margin="0,0,0,0" />

                    <TextBlock Text="安全答案（不区分大小写）"
                               Style="{StaticResource Theme.Text.Caption}"
                               HorizontalAlignment="Left"
                               Margin="0,10,0,4" />
                    <TextBox x:Name="SetupAnswerBox"
                             Style="{StaticResource Theme.Input}"
                             AutomationProperties.Name="安全答案" />

                    <TextBlock x:Name="SetupError"
                               Foreground="{DynamicResource Theme.DangerBrush}"
                               Style="{StaticResource Theme.Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="Collapsed" />

                    <Button x:Name="SetupButton"
                            Content="创建保险库"
                            AutomationProperties.Name="创建保险库"
                            Style="{StaticResource Theme.Button.Primary}"
                            Padding="18,8"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Center"
                            Click="OnSetupClick" />

                    <TextBlock Text="至少 8 位；安全问题与答案用于忘记主密码时找回。"
                               Style="{StaticResource Theme.Text.Tertiary}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>
            </ScrollViewer>

            <!-- 已设置主密码：解锁 -->
            <ScrollViewer x:Name="LockScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
            <Border x:Name="LockCard"
                    Style="{StaticResource Theme.Card}"
                    Padding="28"
                    VerticalAlignment="Top">
                <StackPanel MaxWidth="380"
                            HorizontalAlignment="Center">
                    <Border Width="64"
                            Height="64"
                            CornerRadius="32"
                            Background="{DynamicResource Theme.AccentSoftBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="26"
                                   Foreground="{DynamicResource Theme.AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="保险库已锁定"
                               Style="{StaticResource Theme.Text.Title}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,6" />
                    <TextBlock Text="输入主密码解锁。锁定期间不会从数据库加载任何条目。"
                               Style="{StaticResource Theme.Text.Secondary}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />

                    <PasswordBox x:Name="UnlockPasswordBox"
                                 Style="{StaticResource Theme.PasswordInput}"
                                 AutomationProperties.Name="主密码"
                                 Margin="0,20,0,0"
                                 KeyDown="OnUnlockKeyDown" />

                    <TextBlock x:Name="UnlockError"
                               Foreground="{DynamicResource Theme.DangerBrush}"
                               Style="{StaticResource Theme.Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="Collapsed" />

                    <Button x:Name="UnlockButton"
                            Content="解锁"
                            AutomationProperties.Name="解锁保险库"
                            Style="{StaticResource Theme.Button.Primary}"
                            Padding="18,8"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Center"
                            Click="OnUnlockClick" />

                    <Button x:Name="ForgotPasswordButton"
                            Content="忘记主密码？"
                            AutomationProperties.Name="忘记主密码"
                            Style="{StaticResource Theme.Button.Ghost}"
                            Padding="12,5"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Click="OnForgotPasswordClick" />

                    <TextBlock Text="数据仅在本机加密存储，不会上传云端。"
                               Style="{StaticResource Theme.Text.Tertiary}"
                               TextAlignment="Center"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>
            </ScrollViewer>

            <!-- 已解锁：三栏工作区 -->
            <Border x:Name="WorkspaceCard"
                    Style="{StaticResource Theme.Card}"
                    Padding="0"
                    MinHeight="460"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 分类 -->
                    <Grid Grid.Column="0" Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="分类"
                                   Style="{StaticResource Theme.Text.Caption}" />

                        <StackPanel x:Name="CategoryPanel" Grid.Row="1" Margin="0,8,0,0">
                            <RadioButton x:Name="AllCategory"
                                         Content="全部"
                                         Tag="all"
                                         GroupName="VaultCategory"
                                         AutomationProperties.Name="分类 全部"
                                         Style="{StaticResource Theme.ThemeChoice}"
                                         HorizontalAlignment="Stretch"
                                         Margin="0,0,0,6"
                                         IsChecked="True"
                                         Checked="OnCategoryChecked" />
                            <RadioButton x:Name="LoginCategory"
                                         Content="登录"
                                         Tag="login"
                                         GroupName="VaultCategory"
                                         AutomationProperties.Name="分类 登录"
                                         Style="{StaticResource Theme.ThemeChoice}"
                                         HorizontalAlignment="Stretch"
                                         Margin="0,0,0,6"
                                         Checked="OnCategoryChecked" />
                            <RadioButton x:Name="BankCategory"
                                         Content="银行卡"
                                         Tag="bank"
                                         GroupName="VaultCategory"
                                         AutomationProperties.Name="分类 银行卡"
                                         Style="{StaticResource Theme.ThemeChoice}"
                                         HorizontalAlignment="Stretch"
                                         Margin="0,0,0,6"
                                         Checked="OnCategoryChecked" />
                            <RadioButton x:Name="IdCategory"
                                         Content="证件"
                                         Tag="id"
                                         GroupName="VaultCategory"
                                         AutomationProperties.Name="分类 证件"
                                         Style="{StaticResource Theme.ThemeChoice}"
                                         HorizontalAlignment="Stretch"
                                         Margin="0,0,0,6"
                                         Checked="OnCategoryChecked" />
                            <RadioButton x:Name="SecureNoteCategory"
                                         Content="安全笔记"
                                         Tag="note"
                                         GroupName="VaultCategory"
                                         AutomationProperties.Name="分类 安全笔记"
                                         Style="{StaticResource Theme.ThemeChoice}"
                                         HorizontalAlignment="Stretch"
                                         Margin="0,0,0,6"
                                         Checked="OnCategoryChecked" />
                            <RadioButton x:Name="FavoriteCategory"
                                         Content="收藏"
                                         Tag="favorite"
                                         GroupName="VaultCategory"
                                         AutomationProperties.Name="分类 收藏"
                                         Style="{StaticResource Theme.ThemeChoice}"
                                         HorizontalAlignment="Stretch"
                                         Checked="OnCategoryChecked" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock Text="闲置锁定"
                                       Style="{StaticResource Theme.Text.Caption}" />
                            <ComboBox x:Name="AutoLockBox"
                                      Style="{StaticResource Theme.ComboBox}"
                                      AutomationProperties.Name="闲置锁定"
                                      Margin="0,6,0,0"
                                      SelectionChanged="OnAutoLockChanged">
                                <ComboBoxItem Content="1 分钟" Tag="1" />
                                <ComboBoxItem Content="5 分钟" Tag="5" />
                                <ComboBoxItem Content="15 分钟" Tag="15" />
                                <ComboBoxItem Content="30 分钟" Tag="30" />
                                <ComboBoxItem Content="仅手动锁定" Tag="0" />
                            </ComboBox>

                            <TextBlock Text="复制后清除"
                                       Style="{StaticResource Theme.Text.Caption}"
                                       Margin="0,10,0,0" />
                            <ComboBox x:Name="ClearClipboardBox"
                                      Style="{StaticResource Theme.ComboBox}"
                                      AutomationProperties.Name="复制后清除剪贴板"
                                      Margin="0,6,0,0"
                                      SelectionChanged="OnClearClipboardChanged">
                                <ComboBoxItem Content="10 秒" Tag="10" />
                                <ComboBoxItem Content="20 秒" Tag="20" />
                                <ComboBoxItem Content="30 秒" Tag="30" />
                                <ComboBoxItem Content="60 秒" Tag="60" />
                                <ComboBoxItem Content="不自动清除" Tag="0" />
                            </ComboBox>

                            <TextBlock Text="仅清除密码，且内容未被覆盖时"
                                       Style="{StaticResource Theme.Text.Tertiary}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="1" Background="{DynamicResource Theme.LineBrush}" />

                    <!-- 列表与搜索 -->
                    <Grid Grid.Column="2" Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource Theme.Input}"
                                     AutomationProperties.Name="搜索条目"
                                     TextChanged="OnSearchTextChanged" />
                            <TextBlock x:Name="SearchHint"
                                       Text="搜索标题、用户名或网址"
                                       Style="{StaticResource Theme.Text.Tertiary}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="11,0,0,0" />
                        </Grid>

                        <TextBlock x:Name="ListCountText"
                                   Grid.Row="1"
                                   Style="{StaticResource Theme.Text.Caption}"
                                   Margin="0,10,0,0" />

                        <ScrollViewer Grid.Row="2"
                                      Margin="0,8,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="EntryList" />
                        </ScrollViewer>
                    </Grid>

                    <Border Grid.Column="3" Background="{DynamicResource Theme.LineBrush}" />

                    <!-- 详情 -->
                    <Grid Grid.Column="4" Margin="18,16,18,16">
                        <TextBlock x:Name="DetailEmpty"
                                   Text="选择左侧条目查看详情"
                                   Style="{StaticResource Theme.Text.Secondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />

                        <ScrollViewer x:Name="DetailScroll"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="DetailPanel">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                Margin="0,0,12,0">
                                        <Border x:Name="DetailAvatar"
                                                Width="44"
                                                Height="44"
                                                CornerRadius="22"
                                                Background="{DynamicResource Theme.AccentSoftBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="DetailInitial"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Theme.AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="DetailTitle"
                                                       Style="{StaticResource Theme.Text.SectionTitle}"
                                                       FontSize="18"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="DetailCategory"
                                                       Style="{StaticResource Theme.Text.Caption}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button x:Name="FavoriteButton"
                                                Content="☆"
                                                AutomationProperties.Name="收藏条目"
                                                Style="{StaticResource Theme.Button.Ghost}"
                                                Padding="6,4"
                                                FontSize="16"
                                                Click="OnFavoriteClick" />
                                        <Button Content="编辑"
                                                AutomationProperties.Name="编辑条目"
                                                Style="{StaticResource Theme.Button.Ghost}"
                                                Padding="10,5"
                                                Margin="6,0,0,0"
                                                Click="OnEditClick" />
                                        <Button Content="删除"
                                                AutomationProperties.Name="删除条目"
                                                Style="{StaticResource Theme.Button.Ghost}"
                                                Padding="10,5"
                                                Margin="6,0,0,0"
                                                Foreground="{DynamicResource Theme.DangerBrush}"
                                                Click="OnDeleteClick" />
                                    </StackPanel>
                                </Grid>

                                <Border Height="1"
                                        Background="{DynamicResource Theme.LineBrush}"
                                        Margin="0,14,0,0" />

                                <TextBlock Text="用户名"
                                           Style="{StaticResource Theme.Text.Caption}"
                                           Margin="0,12,0,0" />
                                <Grid Margin="0,4,0,0">
                                    <TextBlock x:Name="UsernameText"
                                               Text="—"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="0,0,60,0" />
                                    <Button x:Name="CopyUsernameButton"
                                            Content="复制"
                                            AutomationProperties.Name="复制用户名"
                                            Style="{StaticResource Theme.Button.Ghost}"
                                            Padding="8,3"
                                            HorizontalAlignment="Right"
                                            Click="OnCopyUsernameClick" />
                                </Grid>

                                <TextBlock Text="密码"
                                           Style="{StaticResource Theme.Text.Caption}"
                                           Margin="0,14,0,0" />
                                <Grid Margin="0,4,0,0">
                                    <TextBlock x:Name="PasswordText"
                                               Text="••••••••"
                                               FontFamily="Consolas"
                                               FontSize="15"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,130,0" />
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Button x:Name="PasswordEyeButton"
                                                Content="显示"
                                                AutomationProperties.Name="显示密码"
                                                Style="{StaticResource Theme.Button.Ghost}"
                                                Padding="8,3"
                                                Click="OnTogglePasswordClick" />
                                        <Button x:Name="CopyPasswordButton"
                                                Content="复制"
                                                AutomationProperties.Name="复制密码"
                                                Style="{StaticResource Theme.Button.Ghost}"
                                                Padding="8,3"
                                                Margin="6,0,0,0"
                                                Click="OnCopyPasswordClick" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Border x:Name="Strength1"
                                            Width="34"
                                            Height="4"
                                            CornerRadius="2"
                                            Margin="0,0,4,0"
                                            Background="{DynamicResource Theme.LineBrush}"
                                            VerticalAlignment="Center" />
                                    <Border x:Name="Strength2"
                                            Width="34"
                                            Height="4"
                                            CornerRadius="2"
                                            Margin="0,0,4,0"
                                            Background="{DynamicResource Theme.LineBrush}"
                                            VerticalAlignment="Center" />
                                    <Border x:Name="Strength3"
                                            Width="34"
                                            Height="4"
                                            CornerRadius="2"
                                            Margin="0,0,4,0"
                                            Background="{DynamicResource Theme.LineBrush}"
                                            VerticalAlignment="Center" />
                                    <Border x:Name="Strength4"
                                            Width="34"
                                            Height="4"
                                            CornerRadius="2"
                                            Background="{DynamicResource Theme.LineBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock x:Name="StrengthLabel"
                                               Text="已隐藏"
                                               Style="{StaticResource Theme.Text.Caption}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0" />
                                </StackPanel>

                                <StackPanel x:Name="UrlBlock" Margin="0,14,0,0">
                                    <TextBlock Text="网址"
                                               Style="{StaticResource Theme.Text.Caption}" />
                                    <TextBlock x:Name="UrlText"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel x:Name="NoteBlock" Margin="0,14,0,0">
                                    <TextBlock Text="备注"
                                               Style="{StaticResource Theme.Text.Caption}" />
                                    <Border Background="{DynamicResource Theme.FieldBrush}"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="0,4,0,0">
                                        <TextBlock x:Name="NoteText" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>

                                <Border Height="1"
                                        Background="{DynamicResource Theme.LineBrush}"
                                        Margin="0,16,0,12" />
                                <StackPanel>
                                    <TextBlock x:Name="CreatedText"
                                               Style="{StaticResource Theme.Text.Caption}" />
                                    <TextBlock x:Name="UpdatedText"
                                               Style="{StaticResource Theme.Text.Caption}"
                                               Margin="0,4,0,0" />
                                    <TextBlock x:Name="UsedText"
                                               Style="{StaticResource Theme.Text.Caption}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
