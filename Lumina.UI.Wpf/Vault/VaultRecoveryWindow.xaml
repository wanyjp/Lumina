<Window x:Class="Lumina.UI.Wpf.Vault.VaultRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Lumina.UI.Wpf.Controls"
        Title="找回主密码"
        Width="560"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.CardSolidBrush}"
        TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
        TextElement.FontSize="{DynamicResource Theme.FontSize.Body}"
        TextElement.Foreground="{DynamicResource Theme.TextBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="找回主密码" Style="{StaticResource Theme.Text.Title}" />
        <TextBlock Text="回答创建保险库时设置的安全问题，并设置新的主密码。"
                   Style="{StaticResource Theme.Text.Secondary}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0" />

        <TextBlock Text="安全问题"
                   Style="{StaticResource Theme.Text.Caption}"
                   Margin="0,16,0,4" />
        <TextBlock x:Name="QuestionText"
                   Style="{StaticResource Theme.Text.Secondary}"
                   TextWrapping="Wrap" />

        <TextBlock Text="安全答案（不区分大小写）"
                   Style="{StaticResource Theme.Text.Caption}"
                   Margin="0,12,0,4" />
        <TextBox x:Name="AnswerBox"
                 Style="{StaticResource Theme.Input}"
                 AutomationProperties.Name="安全答案" />

        <TextBlock Text="新的主密码"
                   Style="{StaticResource Theme.Text.Caption}"
                   Margin="0,12,0,4" />
        <controls:RevealPasswordBox x:Name="NewPasswordBox" InputName="新的主密码" />

        <TextBlock Text="确认新的主密码"
                   Style="{StaticResource Theme.Text.Caption}"
                   Margin="0,10,0,4" />
        <controls:RevealPasswordBox x:Name="ConfirmPasswordBox" InputName="确认新的主密码" />

        <TextBlock x:Name="ErrorText"
                   Foreground="{DynamicResource Theme.DangerBrush}"
                   Style="{StaticResource Theme.Text.Caption}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Visibility="Collapsed" />

        <TextBlock Text="重置后旧主密码立即失效，库内条目会用新密码重新加密。"
                   Style="{StaticResource Theme.Text.Tertiary}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="取消"
                    Style="{StaticResource Theme.Button.Secondary}"
                    Padding="16,7"
                    Click="OnCancelClick" />
            <Button x:Name="ResetButton"
                    Content="重置主密码"
                    Style="{StaticResource Theme.Button.Primary}"
                    Padding="16,7"
                    Margin="10,0,0,0"
                    Click="OnResetClick" />
        </StackPanel>
    </StackPanel>
</Window>
