<Window x:Class="Lumina.UI.Wpf.Notes.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="便签"
        Width="780"
        Height="640"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.CardSolidBrush}"
        TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
        TextElement.FontSize="{DynamicResource Theme.FontSize.Body}"
        TextElement.Foreground="{DynamicResource Theme.TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="便签"
                   Style="{StaticResource Theme.Text.Title}"
                   Margin="0,0,0,12" />

        <TextBox x:Name="TitleBox"
                 Grid.Row="1"
                 Style="{StaticResource Theme.Input}"
                 AutomationProperties.Name="便签标题"
                 MaxLength="80"
                 TextChanged="OnTextChanged" />

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <StackPanel x:Name="ColorPanel"
                        Orientation="Horizontal"
                        VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <RadioButton x:Name="EditTab"
                             Content="编辑"
                             GroupName="NoteMode"
                             AutomationProperties.Name="编辑模式"
                             Style="{StaticResource Theme.ThemeChoice}"
                             Padding="10,4"
                             IsChecked="True"
                             Checked="OnModeChanged" />
                <RadioButton x:Name="PreviewTab"
                             Content="预览"
                             GroupName="NoteMode"
                             AutomationProperties.Name="预览模式"
                             Style="{StaticResource Theme.ThemeChoice}"
                             Padding="10,4"
                             Margin="6,0,0,0"
                             Checked="OnModeChanged" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBox x:Name="ContentBox"
                     Style="{StaticResource Theme.Input}"
                     AutomationProperties.Name="便签正文"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Padding="12"
                     TextChanged="OnTextChanged" />
            <ScrollViewer x:Name="PreviewScroll"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <Border x:Name="PreviewHost"
                        Style="{StaticResource Theme.Card}"
                        Padding="16" />
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="转为清单"
                        AutomationProperties.Name="转为清单"
                        Style="{StaticResource Theme.Button.Ghost}"
                        Padding="10,5"
                        Click="OnToChecklist" />
                <Button Content="转为普通文本"
                        AutomationProperties.Name="转为普通文本"
                        Style="{StaticResource Theme.Button.Ghost}"
                        Padding="10,5"
                        Margin="6,0,0,0"
                        Click="OnToPlainText" />
                <Button Content="转为待办"
                        AutomationProperties.Name="转为待办"
                        Style="{StaticResource Theme.Button.Ghost}"
                        Padding="10,5"
                        Margin="6,0,0,0"
                        Click="OnConvertToTodo" />
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock x:Name="StatusText"
                           Style="{StaticResource Theme.Text.Caption}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <Button Content="完成"
                        AutomationProperties.Name="完成"
                        Style="{StaticResource Theme.Button.Primary}"
                        Padding="18,7"
                        Click="OnDone" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
