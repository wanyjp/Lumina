<UserControl x:Class="Lumina.UI.Wpf.Notes.NoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Lumina.UI.Wpf.Notes"
             Background="Transparent">

    <Grid x:Name="Root">
        <ScrollViewer x:Name="ContentScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentRoot" Margin="0,0,0,18">

                <Border Style="{StaticResource Theme.Card.Strong}" Padding="18">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="便签速记"
                                       Style="{StaticResource Theme.Text.SectionTitle}" />
                            <TextBlock x:Name="SummaryLine"
                                       Text="共 0 条 · 输入后自动保存"
                                       Style="{StaticResource Theme.Text.Tertiary}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText"
                                       Style="{StaticResource Theme.Text.Caption}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <Button x:Name="AddButton"
                                    Content="新建便签"
                                    AutomationProperties.Name="新建便签"
                                    Style="{StaticResource Theme.Button.Primary}"
                                    Padding="14,7"
                                    Click="OnAddClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <UniformGrid x:Name="CardGrid" Columns="3" Margin="0,14,0,0" />

                <Border x:Name="EmptyPanel"
                        Style="{StaticResource Theme.Card}"
                        Margin="0,4,0,0"
                        Padding="36"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="还没有便签"
                                   Style="{StaticResource Theme.Text.SectionTitle}"
                                   TextAlignment="Center" />
                        <TextBlock Text="随手记下想法，支持 Markdown 预览与清单勾选，输入即自动保存。"
                                   Style="{StaticResource Theme.Text.Secondary}"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0" />
                        <Button Content="新建第一条便签"
                                Style="{StaticResource Theme.Button.Primary}"
                                HorizontalAlignment="Center"
                                Margin="0,14,0,0"
                                Click="OnAddClick" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <local:NoteZoomOverlay x:Name="Zoom" />
    </Grid>
</UserControl>
