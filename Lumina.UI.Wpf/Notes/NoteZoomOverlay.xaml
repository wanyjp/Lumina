<UserControl x:Class="Lumina.UI.Wpf.Notes.NoteZoomOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Visibility="Collapsed"
             Focusable="True">

    <UserControl.Resources>
        <Style x:Key="Note.Fab" TargetType="Button" BasedOn="{StaticResource Theme.Button.Secondary}">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="28"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource Theme.AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.AccentBrush}" />
                                <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Border x:Name="Backdrop"
                Background="{DynamicResource Theme.ScrimBrush}"
                MouseLeftButtonDown="OnBackdropMouseDown" />

        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ZoomCard"
                    Grid.Column="0"
                    Width="560"
                    MaxHeight="560"
                    Style="{StaticResource Theme.Card.Strong}"
                    Padding="22"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="CardScale" ScaleX="0.96" ScaleY="0.96" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                        <Ellipse x:Name="ColorDot"
                                 Width="12"
                                 Height="12"
                                 Margin="0,2,10,0"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="TitleText"
                                   Style="{StaticResource Theme.Text.Title}"
                                   TextWrapping="Wrap"
                                   MaxWidth="480" />
                    </StackPanel>

                    <TextBlock x:Name="MetaText"
                               Grid.Row="1"
                               Style="{StaticResource Theme.Text.Caption}"
                               Margin="22,6,0,0" />

                    <ScrollViewer x:Name="BodyScroll"
                                  Grid.Row="2"
                                  Margin="0,16,0,0"
                                  MaxHeight="380"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Border x:Name="BodyHost"
                                Background="{DynamicResource Theme.FieldBrush}"
                                CornerRadius="{DynamicResource Theme.Radius.Small}"
                                Padding="16" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="20,0,0,0">
                <Button x:Name="EditButton"
                        ToolTip="打开编辑窗"
                        AutomationProperties.Name="编辑便签"
                        Style="{StaticResource Note.Fab}"
                        Click="OnEditClick">
                    <Path Width="22"
                          Height="22"
                          Stretch="Uniform"
                          Data="M4,20 L4,16 L16,4 L20,8 L8,20 Z M14,6 L18,10"
                          Stroke="{DynamicResource Theme.TextSecondaryBrush}"
                          StrokeThickness="1.8"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>
                <Button x:Name="DesktopButton"
                        Margin="0,14,0,0"
                        ToolTip="添加到桌面组件"
                        AutomationProperties.Name="添加到桌面"
                        Style="{StaticResource Note.Fab}"
                        Click="OnDesktopClick">
                    <Path Width="22"
                          Height="22"
                          Stretch="Uniform"
                          Data="M4,5 H20 V19 H4 Z M4,9 H20 M9,13 H15"
                          Stroke="{DynamicResource Theme.TextSecondaryBrush}"
                          StrokeThickness="1.8"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>
                <Button x:Name="DeleteButton"
                        Margin="0,14,0,0"
                        ToolTip="删除这条便签"
                        AutomationProperties.Name="删除便签"
                        Style="{StaticResource Note.Fab}"
                        Click="OnDeleteClick">
                    <Path Width="22"
                          Height="22"
                          Stretch="Uniform"
                          Data="M5,7 H19 M9,7 V4 H15 V7 M7,7 L8,20 H16 L17,7"
                          Stroke="{DynamicResource Theme.DangerBrush}"
                          StrokeThickness="1.8"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
