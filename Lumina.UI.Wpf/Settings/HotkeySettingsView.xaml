<UserControl x:Class="Lumina.UI.Wpf.Settings.HotkeySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Background="Transparent">
    <StackPanel>
        <Border Style="{StaticResource Theme.Card}">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="统一快捷键表" Style="{StaticResource Theme.Text.SectionTitle}" Margin="0,0,0,4" />
                        <TextBlock x:Name="SummaryText"
                                   Style="{StaticResource Theme.Text.Tertiary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="ResetAllButton"
                            Content="全部恢复"
                            Style="{StaticResource Theme.Button.Ghost}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Padding="10,5,10,5"
                            FontSize="12" />
                </Grid>

                <Border Height="1" Background="{DynamicResource Theme.LineBrush}" Margin="0,10,0,12" />

                <StackPanel x:Name="RowsPanel" />

                <TextBlock x:Name="StatusText"
                           Style="{StaticResource Theme.Text.Tertiary}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />

                <TextBlock Text="录制时按 Esc 取消；冲突、缺少修饰键或系统占用时保留原值。全局键在任意窗口生效，模块内键只在截图页聚焦时生效；空绑定不参与冲突。"
                           Style="{StaticResource Theme.Text.Tertiary}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
