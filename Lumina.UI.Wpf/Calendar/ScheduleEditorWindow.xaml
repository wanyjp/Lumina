<Window x:Class="Lumina.UI.Wpf.Calendar.ScheduleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日程"
        Width="640"
        SizeToContent="Height"
        MaxHeight="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.CardSolidBrush}"
        TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
        TextElement.FontSize="{DynamicResource Theme.FontSize.Body}"
        TextElement.Foreground="{DynamicResource Theme.TextBrush}">
    <Grid Margin="24">
        <ScrollViewer x:Name="FormScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="840">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Style="{StaticResource Theme.Text.Title}" Margin="0,0,0,16" />

                <TextBlock Text="标题" Style="{StaticResource Theme.Text.Caption}" />
                <TextBox x:Name="TitleBox"
                         Style="{StaticResource Theme.Input}"
                         Margin="0,4,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="开始日期" Style="{StaticResource Theme.Text.Caption}" />
                        <DatePicker x:Name="StartDatePicker"
                                    SelectedDateFormat="Short"
                                    Height="40"
                                    Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="开始时间（可空）" Style="{StaticResource Theme.Text.Caption}" />
                        <ComboBox x:Name="StartTimeBox"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  Height="40"
                                  Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="结束日期（可空）" Style="{StaticResource Theme.Text.Caption}" />
                        <DatePicker x:Name="EndDatePicker"
                                    SelectedDateFormat="Short"
                                    Height="40"
                                    Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="结束时间（可空）" Style="{StaticResource Theme.Text.Caption}" />
                        <ComboBox x:Name="EndTimeBox"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  Height="40"
                                  Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="开始时间留空 = 全天；结束时间留空且已填开始时间 = 开放结束。时间可直接输入任意 HH:mm，也可从下拉建议中选择。"
                           Style="{StaticResource Theme.Text.Tertiary}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,12" />

                <TextBlock Text="地点" Style="{StaticResource Theme.Text.Caption}" />
                <TextBox x:Name="LocationBox"
                         Style="{StaticResource Theme.Input}"
                         Margin="0,4,0,12" />

                <TextBlock Text="备注" Style="{StaticResource Theme.Text.Caption}" />
                <TextBox x:Name="NoteBox"
                         Style="{StaticResource Theme.Input}"
                         Height="112"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,4,0,12" />

                <TextBlock Text="优先级" Style="{StaticResource Theme.Text.Caption}" />
                <WrapPanel x:Name="PriorityPanel" Margin="0,4,0,10" />

                <TextBlock Text="提醒" Style="{StaticResource Theme.Text.Caption}" />
                <WrapPanel x:Name="ReminderPanel" Margin="0,4,0,10" />

                <Border Height="1"
                        Background="{DynamicResource Theme.LineBrush}"
                        Margin="0,6,0,10" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="周期日程"
                               Style="{StaticResource Theme.Text.Base}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <CheckBox x:Name="RepeatToggle"
                              Style="{StaticResource Theme.Toggle}"
                              Content="重复"
                              VerticalAlignment="Center"
                              Margin="12,0,0,0"
                              Click="OnRepeatToggleClick" />
                </StackPanel>
                <TextBlock x:Name="RepeatHint"
                           Style="{StaticResource Theme.Text.Tertiary}"
                           Margin="0,2,0,0" />

                <StackPanel x:Name="RepeatPanel" Visibility="Collapsed" Margin="0,8,0,0">
                    <TextBlock Text="周期方式" Style="{StaticResource Theme.Text.Caption}" />
                    <WrapPanel x:Name="RepeatModePanel" Margin="0,4,0,8" />

                    <StackPanel x:Name="WeekRangePanel" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Text="起始（1=周一，7=周日）" Style="{StaticResource Theme.Text.Caption}" />
                                <ComboBox x:Name="WeekStartBox"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          Width="140"
                                          Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="结束" Style="{StaticResource Theme.Text.Caption}" />
                                <ComboBox x:Name="WeekEndBox"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          Width="140"
                                          Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="结束早于起始时按跨周环绕处理，例如 5 → 1 表示周五至周一。"
                                   Style="{StaticResource Theme.Text.Tertiary}"
                                   Margin="0,4,0,8" />
                    </StackPanel>

                    <StackPanel x:Name="MonthRangePanel" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Text="起始日" Style="{StaticResource Theme.Text.Caption}" />
                                <ComboBox x:Name="MonthStartBox"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          Width="140"
                                          Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="结束日（1–31 或 end）" Style="{StaticResource Theme.Text.Caption}" />
                                <ComboBox x:Name="MonthEndBox"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          Width="140"
                                          Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="每月区间不跨月；结束日填 end 表示月底。"
                                   Style="{StaticResource Theme.Text.Tertiary}"
                                   Margin="0,4,0,8" />
                    </StackPanel>

                    <WrapPanel x:Name="WeekdaysPanel" Visibility="Collapsed" Margin="0,0,0,8" />

                    <StackPanel x:Name="MonthDayPanel" Visibility="Collapsed">
                        <TextBlock Text="每月日期（1–31 或 end）" Style="{StaticResource Theme.Text.Caption}" />
                        <ComboBox x:Name="MonthDayBox"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  Width="140"
                                  Margin="0,4,0,0" />
                        <TextBlock Text="当月没有该日期时自动跳过，例如 31 号在 4 月不生成。"
                                   Style="{StaticResource Theme.Text.Tertiary}"
                                   Margin="0,4,0,8" />
                    </StackPanel>

                    <TextBlock Text="结束条件" Style="{StaticResource Theme.Text.Caption}" Margin="0,4,0,0" />
                    <WrapPanel x:Name="EndTypePanel" Margin="0,4,0,8" />

                    <StackPanel Orientation="Horizontal">
                        <StackPanel x:Name="RepeatEndDatePanel" Margin="0,0,12,0">
                            <TextBlock Text="周期结束日期" Style="{StaticResource Theme.Text.Caption}" />
                            <DatePicker x:Name="RepeatEndDatePicker"
                                        SelectedDateFormat="Short"
                                        Width="260"
                                        Height="40"
                                        Background="{DynamicResource Theme.CardSolidBrush}"
                                        BorderBrush="{DynamicResource Theme.BorderBrush}"
                                        Foreground="{DynamicResource Theme.TextBrush}"
                                        Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel x:Name="RepeatCountPanel">
                            <TextBlock Text="次数（1–366）" Style="{StaticResource Theme.Text.Caption}" />
                            <TextBox x:Name="RepeatCountBox"
                                     Style="{StaticResource Theme.Input}"
                                     Width="110"
                                     Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="单系列最多生成 3700 天；超出部分不生成。"
                               Style="{StaticResource Theme.Text.Tertiary}"
                               Margin="0,6,0,0" />
                    <TextBlock x:Name="RepeatPreviewText"
                               Style="{StaticResource Theme.Text.Caption}"
                               Foreground="{DynamicResource Theme.AccentBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>

                <TextBlock x:Name="ErrorText"
                           Foreground="{DynamicResource Theme.DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="取消"
                            Style="{StaticResource Theme.Button.Ghost}"
                            Margin="0,0,8,0"
                            Click="OnCancelClick" />
                    <Button Content="保存"
                            Style="{StaticResource Theme.Button.Primary}"
                            Click="OnSaveClick" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
