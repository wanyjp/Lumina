<UserControl x:Class="Lumina.UI.Wpf.Calendar.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
             TextElement.FontSize="{DynamicResource Theme.FontSize.Body}"
             TextElement.Foreground="{DynamicResource Theme.TextBrush}"
             Background="Transparent">
    <!-- 页面级滚动：竖版日历或窗口较矮时内容会超过视口，整页可上下滚动，而不是被裁掉。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,6,0">
    <Grid x:Name="LayoutGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ContentControl x:Name="CalendarHost"
                        Grid.Row="0"
                        Grid.Column="0" />

        <Border x:Name="DayPanel"
                Grid.Row="0"
                Grid.Column="1"
                Style="{StaticResource Theme.Card}"
                Margin="16,0,0,0"
                VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock x:Name="DayTitle" Style="{StaticResource Theme.Text.SectionTitle}" Margin="0" />
                        <TextBlock x:Name="DaySubtitle"
                                   Style="{StaticResource Theme.Text.Caption}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Content="＋ 添加"
                            Style="{StaticResource Theme.Button.Primary}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="OnAddClick" />
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="360"
                              Margin="0,10,0,0">
                    <StackPanel x:Name="DayList" />
                </ScrollViewer>

                <TextBlock x:Name="ListHint"
                           Grid.Row="2"
                           Style="{StaticResource Theme.Text.Tertiary}"
                           Margin="0,8,0,0" />

                <Border Grid.Row="3"
                        Height="1"
                        Background="{DynamicResource Theme.LineBrush}"
                        Margin="0,10,0,10" />

                <Grid Grid.Row="4">
                    <TextBlock Text="当天待办"
                               Style="{StaticResource Theme.Text.Base}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button Content="＋ 添加当天待办"
                            Style="{StaticResource Theme.Button.Secondary}"
                            FontSize="{DynamicResource Theme.FontSize.Caption}"
                            Padding="10,4,10,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="OnAddTodoClick" />
                </Grid>

                <ScrollViewer Grid.Row="5"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="240"
                              Margin="0,8,0,0">
                    <StackPanel x:Name="TodoDayList" />
                </ScrollViewer>

                <TextBlock x:Name="TodoDayHint"
                           Grid.Row="6"
                           Style="{StaticResource Theme.Text.Tertiary}"
                           Margin="0,8,0,0" />
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
