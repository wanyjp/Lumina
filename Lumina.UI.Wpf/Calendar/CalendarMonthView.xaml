<UserControl x:Class="Lumina.UI.Wpf.Calendar.CalendarMonthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
             TextElement.FontSize="{DynamicResource Theme.FontSize.Body}"
             TextElement.Foreground="{DynamicResource Theme.TextBrush}"
             Background="Transparent">
    <Border Style="{StaticResource Theme.Card.Strong}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PrevMonthButton"
                            Style="{StaticResource Theme.Button.Secondary}"
                            Width="36"
                            Height="36"
                            Padding="0"
                            ToolTip="上个月"
                            AutomationProperties.Name="上个月"
                            Click="OnPrevClick">
                        <TextBlock Text="&#xE76B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                    </Button>
                    <TextBlock x:Name="MonthTitle"
                               Style="{StaticResource Theme.Text.Title}"
                               VerticalAlignment="Center"
                               Margin="12,0" />
                    <Button x:Name="NextMonthButton"
                            Style="{StaticResource Theme.Button.Secondary}"
                            Width="36"
                            Height="36"
                            Padding="0"
                            ToolTip="下个月"
                            AutomationProperties.Name="下个月"
                            Click="OnNextClick">
                        <TextBlock Text="&#xE76C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                    </Button>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="今天"
                        Style="{StaticResource Theme.Button.Secondary}"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0"
                        Click="OnTodayClick" />
            </Grid>

            <TextBlock x:Name="HolidayNote"
                       Style="{StaticResource Theme.Text.Tertiary}"
                       Margin="0,12,0,0" />

            <UniformGrid x:Name="WeekdayHeader" Columns="7" Margin="0,14,0,2" />
            <Grid x:Name="DayGrid" />
        </StackPanel>
    </Border>
</UserControl>
