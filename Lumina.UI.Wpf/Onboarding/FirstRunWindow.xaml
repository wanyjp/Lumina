<Window x:Class="Lumina.UI.Wpf.Onboarding.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用拾光"
        Width="620"
        SizeToContent="Height"
        MaxHeight="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.CardSolidBrush}"
        TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
        TextElement.FontSize="{DynamicResource Theme.FontSize.Body}"
        TextElement.Foreground="{DynamicResource Theme.TextBrush}"
        AutomationProperties.Name="首次运行引导">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26">
            <TextBlock Text="欢迎使用 拾光"
                       Style="{StaticResource Theme.Text.Title}" />
            <TextBlock Text="花一分钟选择常用偏好。所有设置都可以在设置中心修改，也可以稍后再设置。"
                       Style="{StaticResource Theme.Text.Secondary}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />

            <Border x:Name="DataRootNoticeCard"
                    Background="{DynamicResource Theme.AccentSoftBrush}"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,14,0,0"
                    Visibility="Collapsed">
                <TextBlock x:Name="DataRootNoticeText"
                           TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Theme.Card}"
                    Padding="16"
                    Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="1 · 外观"
                               Style="{StaticResource Theme.Text.SectionTitle}" />
                    <TextBlock Text="选择主题，切换后立即生效。"
                               Style="{StaticResource Theme.Text.Caption}"
                               Margin="0,4,0,0" />
                    <ComboBox x:Name="ThemeBox"
                              Style="{StaticResource Theme.ComboBox}"
                              AutomationProperties.Name="主题"
                              Margin="0,10,0,0"
                              SelectionChanged="OnThemeChanged" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Theme.Card}"
                    Padding="16"
                    Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="2 · 启动"
                               Style="{StaticResource Theme.Text.SectionTitle}" />
                    <CheckBox x:Name="AutoStartToggle"
                              Content="随 Windows 启动"
                              Style="{StaticResource Theme.Toggle}"
                              AutomationProperties.Name="开机自启"
                              Margin="0,10,0,0"
                              Click="OnAutoStartClick" />
                    <TextBlock x:Name="AutoStartHint"
                               Style="{StaticResource Theme.Text.Tertiary}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Theme.Card}"
                    Padding="16"
                    Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="3 · 剪贴板历史"
                               Style="{StaticResource Theme.Text.SectionTitle}" />
                    <CheckBox x:Name="ClipboardToggle"
                              Content="启用剪贴板历史"
                              Style="{StaticResource Theme.Toggle}"
                              AutomationProperties.Name="启用剪贴板历史"
                              Margin="0,10,0,0"
                              Click="OnClipboardToggleClick" />
                    <TextBlock Text="剪贴板内容只保存在本机 %APPDATA%\Lumina，不会上传；密码等敏感内容按忽略规则跳过。可随时在设置中暂停或关闭。"
                               Style="{StaticResource Theme.Text.Tertiary}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <TextBlock x:Name="ClipboardHint"
                               Style="{StaticResource Theme.Text.Tertiary}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Theme.Card}"
                    Padding="16"
                    Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="4 · 密码管理器"
                               Style="{StaticResource Theme.Text.SectionTitle}" />
                    <TextBlock Text="主密码只在本机用于派生加密密钥，不会上传。建议同时设置安全问题和答案，忘记主密码时可以找回。"
                               Style="{StaticResource Theme.Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                    <TextBlock x:Name="VaultStatusText"
                               Style="{StaticResource Theme.Text.Secondary}"
                               Margin="0,10,0,0" />
                    <Button x:Name="SetupVaultButton"
                            Content="现在设置主密码"
                            Style="{StaticResource Theme.Button.Secondary}"
                            Padding="14,7"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="现在设置主密码"
                            Margin="0,10,0,0"
                            Click="OnSetupVaultClick" />
                    <TextBlock Text="可稍后在「密码管理器」中设置。"
                               Style="{StaticResource Theme.Text.Tertiary}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button Content="稍后设置"
                        Style="{StaticResource Theme.Button.Ghost}"
                        Padding="16,7"
                        AutomationProperties.Name="稍后设置"
                        Click="OnSkipClick" />
                <Button Content="开始使用"
                        Style="{StaticResource Theme.Button.Primary}"
                        Padding="18,8"
                        Margin="10,0,0,0"
                        AutomationProperties.Name="开始使用"
                        Click="OnFinishClick" />
            </StackPanel>
            <TextBlock Text="之后可在「设置 → 关于 → 首次引导」重新打开本页。"
                       Style="{StaticResource Theme.Text.Tertiary}"
                       HorizontalAlignment="Right"
                       Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
