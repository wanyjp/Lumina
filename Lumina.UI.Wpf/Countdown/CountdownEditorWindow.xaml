<Window x:Class="Lumina.UI.Wpf.Countdown.CountdownEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="倒计时"
        Width="620"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.CardSolidBrush}"
        TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
        TextElement.FontSize="{DynamicResource Theme.FontSize.Body}"
        TextElement.Foreground="{DynamicResource Theme.TextBrush}">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Style="{StaticResource Theme.Text.Title}" Margin="0,0,0,16" />

            <TextBlock Text="名称" Style="{StaticResource Theme.Text.Caption}" />
            <TextBox x:Name="NameBox"
                     AutomationProperties.Name="倒计时名称"
                     Style="{StaticResource Theme.Input}"
                     MaxLength="60"
                     Margin="0,4,0,12"
                     TextChanged="OnNameChanged" />

            <TextBlock Text="分类" Style="{StaticResource Theme.Text.Caption}" />
            <WrapPanel x:Name="CategoryPanel" Margin="0,4,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="重复方式" Style="{StaticResource Theme.Text.Caption}" />
                    <ComboBox x:Name="RepeatBox"
                              AutomationProperties.Name="重复方式"
                              Height="40"
                              Margin="0,4,0,0"
                              SelectionChanged="OnRepeatChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="提前提醒" Style="{StaticResource Theme.Text.Caption}" />
                    <ComboBox x:Name="ReminderBox"
                              AutomationProperties.Name="提前提醒"
                              Height="40"
                              Margin="0,4,0,0"
                              SelectionChanged="OnSelectionChanged" />
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource Theme.WallSecondaryBrush}"
                    BorderBrush="{DynamicResource Theme.BorderBrush}"
                    BorderThickness="{DynamicResource Theme.Stroke.Hairline}"
                    CornerRadius="{DynamicResource Theme.Radius.Small}"
                    Padding="14"
                    Margin="0,14,0,0">
                <Grid>
                    <StackPanel x:Name="OncePanel">
                        <TextBlock Text="目标日期" Style="{StaticResource Theme.Text.Caption}" />
                        <DatePicker x:Name="OnceDatePicker"
                                    AutomationProperties.Name="目标日期"
                                    Height="40"
                                    Margin="0,4,0,0"
                                    SelectedDateChanged="OnDateChanged" />
                    </StackPanel>

                    <StackPanel x:Name="WeeklyPanel" Visibility="Collapsed">
                        <TextBlock Text="星期" Style="{StaticResource Theme.Text.Caption}" />
                        <ComboBox x:Name="WeekdayBox"
                                  AutomationProperties.Name="星期"
                                  Height="40"
                                  Margin="0,4,0,0"
                                  SelectionChanged="OnSelectionChanged" />
                    </StackPanel>

                    <StackPanel x:Name="MonthlyPanel" Visibility="Collapsed">
                        <TextBlock Text="每月几号" Style="{StaticResource Theme.Text.Caption}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="MonthlyDayBox"
                                      AutomationProperties.Name="每月日号"
                                      Height="40"
                                      SelectionChanged="OnSelectionChanged" />
                            <CheckBox x:Name="MonthEndCheck"
                                      AutomationProperties.Name="月底"
                                      Grid.Column="1"
                                      Content="月底（自动取当月最后一天）"
                                      VerticalAlignment="Center"
                                      Margin="12,0,0,0"
                                      Checked="OnMonthEndChanged"
                                      Unchecked="OnMonthEndChanged" />
                        </Grid>
                        <TextBlock Text="选择“月底”后，2 月自动取 28/29 日，4 月自动取 30 日。"
                                   Style="{StaticResource Theme.Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="YearlyPanel" Visibility="Collapsed">
                        <TextBlock Text="月份与日号" Style="{StaticResource Theme.Text.Caption}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="MonthBox"
                                      AutomationProperties.Name="每年月份"
                                      Height="40"
                                      SelectionChanged="OnMonthChanged" />
                            <ComboBox x:Name="YearlyDayBox"
                                      AutomationProperties.Name="每年日号"
                                      Grid.Column="2"
                                      Height="40"
                                      SelectionChanged="OnSelectionChanged" />
                        </Grid>
                        <TextBlock Text="2 月 29 日在平年自动取 2 月 28 日。"
                                   Style="{StaticResource Theme.Text.Tertiary}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="{DynamicResource Theme.WallSecondaryBrush}"
                    CornerRadius="{DynamicResource Theme.Radius.Small}"
                    Padding="12,10"
                    Margin="0,12,0,0">
                <TextBlock x:Name="PreviewText"
                           Text="填写名称并选择日期后，这里会预览下次发生日。"
                           Style="{StaticResource Theme.Text.Secondary}"
                           TextWrapping="Wrap" />
            </Border>

            <TextBlock x:Name="ErrorText"
                       Foreground="{DynamicResource Theme.DangerBrush}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="取消"
                        Style="{StaticResource Theme.Button.Ghost}"
                        Margin="0,0,8,0"
                        Click="OnCancelClick" />
                <Button Content="保存"
                        Style="{StaticResource Theme.Button.Primary}"
                        Click="OnSaveClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
