<UserControl x:Class="Lumina.UI.Wpf.Countdown.CountdownZoomOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Visibility="Collapsed"
             Focusable="True">

    <UserControl.Resources>
        <Style x:Key="Countdown.Fab" TargetType="Button" BasedOn="{StaticResource Theme.Button.Secondary}">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="28"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource Theme.AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.AccentBrush}" />
                                <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Countdown.Progress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border x:Name="PART_Track"
                                Height="6"
                                Background="{DynamicResource Theme.LineBrush}"
                                CornerRadius="3">
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Border x:Name="Backdrop"
                Background="{DynamicResource Theme.ScrimBrush}"
                MouseLeftButtonDown="OnBackdropMouseDown" />

        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="Card"
                    Width="620"
                    Padding="32"
                    Style="{StaticResource Theme.Card.Strong}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="CardScale" ScaleX="0.86" ScaleY="0.86" />
                </Border.RenderTransform>

                <StackPanel>
                    <Border x:Name="CategoryChip"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Theme.WallSecondaryBrush}"
                            BorderBrush="{DynamicResource Theme.BorderBrush}"
                            BorderThickness="{DynamicResource Theme.Stroke.Hairline}"
                            CornerRadius="{DynamicResource Theme.Radius.Pill}"
                            Padding="9,3">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="CategoryIcon"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource Theme.TextSecondaryBrush}"
                                  StrokeThickness="1.7"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <TextBlock x:Name="CategoryText"
                                       Style="{StaticResource Theme.Text.Caption}"
                                       Margin="5,0,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="LabelText"
                               FontSize="19"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.TextSecondaryBrush}"
                               Margin="0,18,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock x:Name="NumberText"
                                   FontSize="86"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource Theme.FontFamily}" />
                        <TextBlock x:Name="NumberUnit"
                                   Text="天"
                                   Style="{StaticResource Theme.Text.Caption}"
                                   FontSize="{DynamicResource Theme.FontSize.Subtitle}"
                                   VerticalAlignment="Bottom"
                                   Margin="6,0,0,12" />
                    </StackPanel>

                    <TextBlock x:Name="SemanticText"
                               Style="{StaticResource Theme.Text.Secondary}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />

                    <TextBlock x:Name="RemainingText"
                               Style="{StaticResource Theme.Text.Secondary}"
                               Margin="0,8,0,0" />

                    <ProgressBar x:Name="Progress"
                                 Style="{StaticResource Countdown.Progress}"
                                 Margin="0,18,0,0"
                                 Value="0" />

                    <TextBlock x:Name="NoteText"
                               Style="{StaticResource Theme.Text.Tertiary}"
                               TextWrapping="Wrap"
                               Margin="0,16,0,0" />

                    <TextBlock Text="点击空白处或按 Esc 返回列表"
                               Style="{StaticResource Theme.Text.Caption}"
                               Margin="0,18,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="20,0,0,0">
                <Button x:Name="EditButton"
                        Style="{StaticResource Countdown.Fab}"
                        ToolTip="编辑"
                        AutomationProperties.Name="编辑倒计时"
                        Click="OnEditClick">
                    <Path Width="22"
                          Height="22"
                          Stretch="Uniform"
                          Data="M4,20 L4,16 L16,4 L20,8 L8,20 Z M14,6 L18,10"
                          Stroke="{DynamicResource Theme.TextSecondaryBrush}"
                          StrokeThickness="1.8"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>

                <Button x:Name="DesktopButton"
                        Style="{StaticResource Countdown.Fab}"
                        Margin="0,14,0,0"
                        ToolTip="添加到桌面"
                        AutomationProperties.Name="添加倒计时到桌面"
                        Click="OnDesktopClick">
                    <Path Width="22"
                          Height="22"
                          Stretch="Uniform"
                          Data="M4,5 H20 V19 H4 Z M4,9 H20 M9,13 H15"
                          Stroke="{DynamicResource Theme.TextSecondaryBrush}"
                          StrokeThickness="1.8"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>

                <Button x:Name="DeleteButton"
                        Style="{StaticResource Countdown.Fab}"
                        Margin="0,14,0,0"
                        ToolTip="删除"
                        AutomationProperties.Name="删除倒计时"
                        Click="OnDeleteClick">
                    <Path Width="22"
                          Height="22"
                          Stretch="Uniform"
                          Data="M5,7 H19 M9,7 V4 H15 V7 M7,7 L8,20 H16 L17,7"
                          Stroke="{DynamicResource Theme.DangerBrush}"
                          StrokeThickness="1.8"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
