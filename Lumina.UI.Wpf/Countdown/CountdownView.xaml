<UserControl x:Class="Lumina.UI.Wpf.Countdown.CountdownView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Lumina.UI.Wpf.Countdown"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="Countdown.CardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="Root" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.94" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Countdown.Progress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border x:Name="PART_Track"
                                Background="{DynamicResource Theme.LineBrush}"
                                CornerRadius="2">
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <ScrollViewer x:Name="ContentScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentRoot" Margin="0,0,0,18">

                <Border Style="{StaticResource Theme.Card.Strong}" Padding="18">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="重要日期与重复提醒"
                                       Style="{StaticResource Theme.Text.SectionTitle}" />
                            <TextBlock x:Name="SummaryLine"
                                       Text="共 0 项"
                                       Style="{StaticResource Theme.Text.Tertiary}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText"
                                       Style="{StaticResource Theme.Text.Caption}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <Button x:Name="AddButton"
                                    Content="新增日期"
                                    Style="{StaticResource Theme.Button.Primary}"
                                    Padding="14,7"
                                    Click="OnAddClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <WrapPanel x:Name="FilterPanel" Margin="0,14,0,0">
                    <RadioButton x:Name="AllFilter"
                                 Tag="all"
                                 GroupName="CountdownFilter"
                                 Style="{StaticResource Theme.ThemeChoice}"
                                 IsChecked="True"
                                 Margin="0,0,8,8"
                                 Checked="OnFilterChecked" />
                    <RadioButton x:Name="WorkFilter"
                                 Tag="work"
                                 GroupName="CountdownFilter"
                                 Style="{StaticResource Theme.ThemeChoice}"
                                 Margin="0,0,8,8"
                                 Checked="OnFilterChecked" />
                    <RadioButton x:Name="LifeFilter"
                                 Tag="life"
                                 GroupName="CountdownFilter"
                                 Style="{StaticResource Theme.ThemeChoice}"
                                 Margin="0,0,8,8"
                                 Checked="OnFilterChecked" />
                    <RadioButton x:Name="ExamFilter"
                                 Tag="exam"
                                 GroupName="CountdownFilter"
                                 Style="{StaticResource Theme.ThemeChoice}"
                                 Margin="0,0,8,8"
                                 Checked="OnFilterChecked" />
                    <RadioButton x:Name="AnniversaryFilter"
                                 Tag="anniv"
                                 GroupName="CountdownFilter"
                                 Style="{StaticResource Theme.ThemeChoice}"
                                 Margin="0,0,8,8"
                                 Checked="OnFilterChecked" />
                    <RadioButton x:Name="OtherFilter"
                                 Tag="other"
                                 GroupName="CountdownFilter"
                                 Style="{StaticResource Theme.ThemeChoice}"
                                 Margin="0,0,8,8"
                                 Checked="OnFilterChecked" />
                </WrapPanel>

                <UniformGrid x:Name="CardGrid" Columns="3" Margin="0,4,0,0" />

                <Border x:Name="EmptyPanel"
                        Style="{StaticResource Theme.Card}"
                        Margin="0,4,0,0"
                        Padding="36"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="EmptyTitle"
                                   Text="还没有倒计时"
                                   Style="{StaticResource Theme.Text.SectionTitle}"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="EmptyBody"
                                   Text="记录考试、纪念日或周期性节点，卡片会按紧迫度自动分档。"
                                   Style="{StaticResource Theme.Text.Secondary}"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0" />
                        <Button Content="新增第一个倒计时"
                                Style="{StaticResource Theme.Button.Primary}"
                                HorizontalAlignment="Center"
                                Margin="0,14,0,0"
                                Click="OnAddClick" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <local:CountdownZoomOverlay x:Name="Zoom" />
    </Grid>
</UserControl>
