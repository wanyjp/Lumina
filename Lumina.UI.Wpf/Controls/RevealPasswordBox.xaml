<UserControl x:Class="Lumina.UI.Wpf.Controls.RevealPasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <PasswordBox x:Name="HiddenBox"
                         Style="{StaticResource Theme.PasswordInput}"
                         PasswordChanged="OnHiddenPasswordChanged" />
            <TextBox x:Name="VisibleBox"
                     Style="{StaticResource Theme.Input}"
                     Visibility="Collapsed"
                     TextChanged="OnVisibleTextChanged" />
        </Grid>

        <Button x:Name="RevealButton"
                Grid.Column="1"
                Style="{StaticResource Theme.Button.Ghost}"
                Padding="8,4"
                Margin="6,0,0,0"
                ToolTip="显示密码"
                AutomationProperties.Name="显示密码"
                Click="OnToggleClick">
            <TextBlock x:Name="RevealGlyph"
                       Text="&#xE7B3;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="14" />
        </Button>
    </Grid>
</UserControl>
