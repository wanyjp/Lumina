<UserControl x:Class="Lumina.Widgets.CountdownWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Lumina.Widgets"
             Background="Transparent"
             TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
             TextElement.Foreground="{DynamicResource Theme.Widget.TextBrush}">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Effect" Value="{DynamicResource Theme.WidgetTextShadow}" />
        </Style>

        <Style x:Key="CountdownWidget.Progress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border x:Name="PART_Track"
                                Background="{DynamicResource Theme.LineBrush}"
                                CornerRadius="2">
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <local:WidgetGlassSurface x:Name="Glass" CornerRadius="{DynamicResource Theme.Radius.Large}" />
        <Border x:Name="Card"
                Style="{StaticResource Theme.Card.Strong}"
                Background="{DynamicResource Theme.CardSolidBrush}"
                Effect="{x:Null}"
                Padding="12,10"
                MouseLeftButtonDown="OnCardMouseDown"
                Cursor="Hand">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="CategoryChip"
                                Background="{DynamicResource Theme.WallSecondaryBrush}"
                                BorderBrush="{DynamicResource Theme.BorderBrush}"
                                BorderThickness="{DynamicResource Theme.Stroke.Hairline}"
                                CornerRadius="{DynamicResource Theme.Radius.Pill}"
                                Padding="7,2">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="CategoryIcon"
                                      Width="10"
                                      Height="10"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource Theme.TextSecondaryBrush}"
                                      StrokeThickness="1.7"
                                      StrokeLineJoin="Round" />
                                <TextBlock x:Name="CategoryText"
                                           FontSize="11"
                                           Margin="4,0,0,0"
                                           Foreground="{DynamicResource Theme.Widget.TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Button x:Name="CloseButton"
                            Content="×"
                            Style="{StaticResource Theme.Button.Ghost}"
                            Width="24"
                            Height="24"
                            Padding="0"
                            FontSize="13"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            ToolTip="关闭组件"
                            Click="OnCloseClick" />
                </Grid>

                <TextBlock x:Name="NameText"
                           Grid.Row="1"
                           FontSize="16"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,4,0,0" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,0">
                    <TextBlock x:Name="NumberText"
                               FontSize="38"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="NumberUnit"
                               Text="天"
                               FontSize="12"
                               VerticalAlignment="Bottom"
                               Margin="4,0,0,6"
                               Foreground="{DynamicResource Theme.Widget.TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,2,0,0">
                    <TextBlock x:Name="RepeatText"
                               FontSize="12.5"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Theme.Widget.TextSecondaryBrush}" />
                    <TextBlock x:Name="NextDateText"
                               FontSize="12.5"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Theme.Widget.TextSecondaryBrush}" />
                </StackPanel>

                <TextBlock x:Name="RemainingText"
                           Grid.Row="4"
                           FontSize="12.5"
                           Foreground="{DynamicResource Theme.Widget.TextBrush}"
                           Margin="0,4,0,0" />

                <ProgressBar x:Name="Progress"
                             Grid.Row="5"
                             Style="{StaticResource CountdownWidget.Progress}"
                             Margin="0,6,0,0"
                             Value="0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
