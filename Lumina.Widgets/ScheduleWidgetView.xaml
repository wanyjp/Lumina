<UserControl x:Class="Lumina.Widgets.ScheduleWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Lumina.Widgets"
             Background="Transparent"
             TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
             TextElement.Foreground="{DynamicResource Theme.Widget.TextBrush}">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Effect" Value="{DynamicResource Theme.WidgetTextShadow}" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="10">
        <local:WidgetGlassSurface x:Name="Glass" CornerRadius="{DynamicResource Theme.Radius.Large}" />
        <Border x:Name="Card"
                Style="{StaticResource Theme.Card.Strong}"
                Effect="{x:Null}"
                Padding="16,12"
                MouseLeftButtonDown="OnCardMouseDown"
                Cursor="Hand">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="DateText"
                                   FontSize="{DynamicResource Theme.FontSize.Caption}"
                                   Foreground="{DynamicResource Theme.AccentBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SummaryText"
                                   FontSize="{DynamicResource Theme.FontSize.Body}"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="CloseButton"
                            Content="×"
                            Style="{StaticResource Theme.Button.Ghost}"
                            Width="24"
                            Height="24"
                            Padding="0"
                            FontSize="12"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="OnCloseClick" />
                </Grid>

                <!-- 安排与待办共用一块滚动区：条目多时上下滚动，不再只露出前 3 条。 -->
                <ScrollViewer x:Name="BodyScroll"
                              Grid.Row="1"
                              Margin="0,8,0,0"
                              Padding="0,0,4,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel x:Name="EventsPanel" />

                        <Border Height="1"
                                Background="{DynamicResource Theme.LineBrush}"
                                Margin="0,8,0,6" />

                        <StackPanel x:Name="TodosPanel" />
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="QuickAddBox"
                             Style="{StaticResource Theme.Input}"
                             FontSize="{DynamicResource Theme.FontSize.Small}"
                             Padding="8,5,8,5"
                             KeyDown="OnQuickAddKeyDown"
                             ToolTip="输入标题后按 Enter 或点击添加" />
                    <Button x:Name="AddButton"
                            Grid.Column="1"
                            Content="添加"
                            Style="{StaticResource Theme.Button.Ghost}"
                            Padding="10,5,10,5"
                            FontSize="12"
                            Margin="8,0,0,0"
                            Click="OnQuickAddClick" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
