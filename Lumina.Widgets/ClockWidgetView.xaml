<UserControl x:Class="Lumina.Widgets.ClockWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Lumina.Widgets"
             Background="Transparent"
             TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
             TextElement.FontSize="{DynamicResource Theme.FontSize.Body}"
             TextElement.Foreground="{DynamicResource Theme.Widget.TextBrush}">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Effect" Value="{DynamicResource Theme.WidgetTextShadow}" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="10">
        <local:WidgetGlassSurface x:Name="Glass" CornerRadius="{DynamicResource Theme.Radius.Large}" />
        <Border x:Name="Card"
                Style="{StaticResource Theme.Card.Strong}"
                Effect="{x:Null}"
                MouseLeftButtonDown="OnCardMouseDown"
                Cursor="Hand">
            <Grid>
                <Border Height="3"
                        Background="{DynamicResource Theme.AccentBrush}"
                        CornerRadius="2"
                        VerticalAlignment="Top"
                        Margin="0,-8,0,0" />

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,6,0,0">
                    <TextBlock x:Name="PeriodText"
                               FontSize="{DynamicResource Theme.FontSize.Caption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.AccentBrush}"
                               Margin="0,0,0,2" />
                    <TextBlock x:Name="TimeText"
                               Style="{StaticResource Theme.Text.Mono}"
                               FontSize="{DynamicResource Theme.FontSize.Display}"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="DateText"
                               Style="{StaticResource Theme.Text.Secondary}"
                               FontSize="{DynamicResource Theme.FontSize.Small}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Button x:Name="CloseButton"
                        Content="×"
                        Style="{StaticResource Theme.Button.Ghost}"
                        Width="24"
                        Height="24"
                        Padding="0"
                        FontSize="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="OnCloseClick" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
