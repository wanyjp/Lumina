<UserControl x:Class="Lumina.Widgets.TimerWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Lumina.Widgets"
             Background="Transparent"
             TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
             TextElement.Foreground="{DynamicResource Theme.Widget.TextBrush}">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Effect" Value="{DynamicResource Theme.WidgetTextShadow}" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="RootGrid" Margin="10">
        <local:WidgetGlassSurface x:Name="Glass" CornerRadius="{DynamicResource Theme.Radius.Large}" />
        <Border x:Name="Card"
                Style="{StaticResource Theme.Card.Strong}"
                Effect="{x:Null}"
                Padding="14,10"
                Cursor="Hand">
            <StackPanel VerticalAlignment="Center">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="LabelText"
                                   FontSize="{DynamicResource Theme.FontSize.Caption}"
                                   Foreground="{DynamicResource Theme.AccentBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="ModeText"
                                   FontSize="{DynamicResource Theme.FontSize.Caption}"
                                   Foreground="{DynamicResource Theme.Widget.TextTertiaryBrush}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="ReturnButton"
                            Content="&#xE72B;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="11"
                            ToolTip="返回主窗口并关闭小组件"
                            Style="{StaticResource Theme.Button.Ghost}"
                            Width="24"
                            Height="24"
                            Padding="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Click="OnReturnClick" />
                    <Button x:Name="CloseButton"
                            Content="&#xE711;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            ToolTip="关闭小组件"
                            Style="{StaticResource Theme.Button.Ghost}"
                            Width="26"
                            Height="26"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="OnCloseClick" />
                </Grid>

                <TextBlock x:Name="TimeText"
                           Style="{StaticResource Theme.Text.Mono}"
                           FontSize="38"
                           FontWeight="SemiBold"
                           LineHeight="44"
                           TextAlignment="Center"
                           Margin="0,2,0,0" />

                <!-- 小尺寸：数字与单位共用同一套列宽，保证「小时/分钟/秒」逐组居中对齐。 -->
                <Grid x:Name="CompactTimeGrid"
                      HorizontalAlignment="Center"
                      Margin="0,2,0,0"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                </Grid>

                <StackPanel x:Name="ButtonRow"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0">
                    <Button x:Name="PlayPauseButton"
                            Content="&#xE768;"
                            Style="{StaticResource Theme.Widget.Action}"
                            ToolTip="开始"
                            Click="OnPlayPauseClick" />
                    <Button x:Name="MarkButton"
                            Content="&#xE7C1;"
                            Style="{StaticResource Theme.Widget.Action}"
                            Margin="10,0,0,0"
                            ToolTip="标记"
                            Click="OnMarkClick" />
                    <Button x:Name="ResetButton"
                            Content="&#xE777;"
                            Style="{StaticResource Theme.Widget.Action}"
                            Margin="10,0,0,0"
                            ToolTip="重置"
                            Click="OnResetClick" />
                </StackPanel>

                <TextBlock x:Name="HintText"
                           Style="{StaticResource Theme.Text.Tertiary}"
                           FontSize="{DynamicResource Theme.FontSize.Caption}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
