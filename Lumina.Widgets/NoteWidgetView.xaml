<UserControl x:Class="Lumina.Widgets.NoteWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Lumina.Widgets"
             Background="Transparent"
             TextElement.FontFamily="{DynamicResource Theme.FontFamily}"
             TextElement.Foreground="{DynamicResource Theme.Widget.TextBrush}">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Effect" Value="{DynamicResource Theme.WidgetTextShadow}" />
        </Style>

        <Style x:Key="NoteWidget.CheckRow" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="{DynamicResource Theme.Radius.Small}"
                                Padding="2,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <local:WidgetGlassSurface x:Name="Glass" CornerRadius="{DynamicResource Theme.Radius.Large}" />
        <Border x:Name="Card"
                Style="{StaticResource Theme.Card.Strong}"
                Background="{DynamicResource Theme.CardSolidBrush}"
                Effect="{x:Null}"
                Padding="14,12"
                MouseLeftButtonDown="OnCardMouseDown"
                Cursor="Hand">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ColorDot"
                                 Width="8"
                                 Height="8"
                                 Margin="0,1,7,0"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="TitleText"
                                   Text="便签"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="200" />
                    </StackPanel>
                    <Button x:Name="CloseButton"
                            Content="✕"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource Theme.Button.Ghost}"
                            Padding="6,2"
                            FontSize="11"
                            AutomationProperties.Name="关闭便签组件"
                            Click="OnCloseClick" />
                </Grid>

                <TextBlock x:Name="MetaText"
                           Grid.Row="1"
                           FontSize="12"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource Theme.Widget.TextTertiaryBrush}" />

                <ScrollViewer x:Name="BodyScroll"
                              Grid.Row="2"
                              Margin="0,7,0,0"
                              MaxHeight="360"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="LinesPanel" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
